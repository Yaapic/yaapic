<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Yaapic.Core\Yaapic.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Yaapic.Infrastructure\Yaapic.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Yaapic.Scripting\Yaapic.Scripting.csproj" />
  </ItemGroup>
</Project>
