<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Avalonia launch-option parser is plain BCL code: compile it here instead of referencing the UI project. -->
    <Compile Include="..\..\src\Yaapic.App.Avalonia\Services\CaptureOptions.cs" Link="CaptureOptions.cs" />
    <!-- Likewise the WinUI text helpers: plain C# over the Domain enums. -->
    <Compile Include="..\..\src\Yaapic.App.WinUI\Presentation\TextMap.cs" Link="TextMap.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Yaapic.Domain\Yaapic.Domain.csproj" />
    <ProjectReference Include="..\..\src\Yaapic.Core\Yaapic.Core.csproj" />
    <ProjectReference Include="..\..\src\Yaapic.UI.Abstractions\Yaapic.UI.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Yaapic.ViewModels\Yaapic.ViewModels.csproj" />
    <ProjectReference Include="..\Yaapic.TestDoubles\Yaapic.TestDoubles.csproj" />
  </ItemGroup>
</Project>
