<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Styles, templates and metrics only: every colour comes from the generated Yaapic.Colors dictionary. -->
  <Thickness x:Key="ButtonPadding">14,0,14,0</Thickness>
  <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,2</Thickness>
  <x:String x:Key="YaapicGlyphClose">M6 6l12 12M18 6 6 18</x:String>
  <x:String x:Key="YaapicGlyphAdd">M12 5v14M5 12h14</x:String>
  <x:String x:Key="YaapicGlyphChevronDown">M6 9l6 6 6-6</x:String>

  <!-- Secondary: the implicit button. -->
  <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource YaapicControlHeight}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusControl}"/>
  </Style>

  <!-- Primary: one per view. -->
  <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource YaapicControlHeight}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusControl}"/>
  </Style>

  <!-- Dialog buttons: centred at the control height like the accent / danger ones (the implicit style stretches them to the button row). -->
  <Style x:Key="YaapicDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource YaapicControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusControl}"/>
  </Style>

  <!-- Primary dialog button: a code lookup of AccentButtonStyle returns the stock style, so the dialogs use this distinct key. -->
  <Style x:Key="YaapicPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource YaapicControlHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusControl}"/>
  </Style>

  <Style x:Key="YaapicSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource YaapicControlHeight}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusControl}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                            BackgroundSizing="{TemplateBinding BackgroundSizing}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw">
            <ContentPresenter.BackgroundTransition>
              <BrushTransition Duration="0:0:0.083"/>
            </ContentPresenter.BackgroundTransition>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
            <VisualState x:Name="PointerOver">
              <Storyboard>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicOverlayHoverBrush}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
                </ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Pressed">
              <Storyboard>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicOverlayPressedBrush}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicTextSecondaryBrush}"/>
                </ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Disabled">
              <Storyboard>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicTextDisabledBrush}"/>
                </ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="YaapicDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinHeight" Value="{StaticResource YaapicControlHeight}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusControl}"/>
    <Setter Property="Background" Value="{ThemeResource YaapicDangerBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource YaapicDangerBorderBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicDangerBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                            BackgroundSizing="{TemplateBinding BackgroundSizing}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw">
            <ContentPresenter.BackgroundTransition>
              <BrushTransition Duration="0:0:0.083"/>
            </ContentPresenter.BackgroundTransition>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
            <VisualState x:Name="PointerOver">
              <Storyboard>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicDangerBackgroundHoverBrush}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicDangerBrush}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicDangerBrush}"/>
                </ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Pressed">
              <Storyboard>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicDangerBackgroundPressedBrush}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicDangerBorderBrush}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicDangerBrush}"/>
                </ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
            <VisualState x:Name="Disabled">
              <Storyboard>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBorderBrushDisabled}"/>
                </ObjectAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource YaapicTextDisabledBrush}"/>
                </ObjectAnimationUsingKeyFrames>
              </Storyboard>
            </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Icon button: content is a 16 px PathIcon whose Data is a Yi* geometry. -->
  <Style x:Key="YaapicIconButtonStyle" TargetType="Button" BasedOn="{StaticResource YaapicSubtleButtonStyle}">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextSecondaryBrush}"/>
  </Style>

  <!-- Navigation rail button: 36 px, radius 6. -->
  <Style x:Key="YaapicRailButtonStyle" TargetType="Button" BasedOn="{StaticResource YaapicIconButtonStyle}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusControl}"/>
  </Style>

  <!-- Metrics read by the WinUI templates: 2 px progress track, 400 px dialogs, 2 px panel-tab underline. -->
  <x:Double x:Key="ProgressBarMinHeight">2</x:Double>
  <x:Double x:Key="ProgressBarTrackHeight">2</x:Double>
  <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
  <x:Double x:Key="SelectorBarItemPillHeight">2</x:Double>
  <CornerRadius x:Key="ProgressBarCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="ProgressBarTrackCornerRadius">0</CornerRadius>
  <Thickness x:Key="SelectorBarItemSelectionVisualMargin">0</Thickness>
  <SolidColorBrush x:Key="SelectorBarItemBackground" Color="Transparent"/>
  <SolidColorBrush x:Key="SelectorBarItemBackgroundPointerOver" Color="Transparent"/>
  <SolidColorBrush x:Key="SelectorBarItemBackgroundPressed" Color="Transparent"/>
  <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="Transparent"/>

  <!-- List row: 26 px; the stock 16 px selection pill is the indicator (wrapping the presenter in a Grid to draw a full-height bar crashes XAML at load). -->
  <Style x:Key="YaapicListRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="8,0,10,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <ListViewItemPresenter x:Name="Root" ContentTransitions="{TemplateBinding ContentTransitions}" Control.IsTemplateFocusTarget="True" FocusVisualMargin="{TemplateBinding FocusVisualMargin}" FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}" FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}" FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}" FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}" PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}" PressedBackground="{ThemeResource ListViewItemBackgroundPressed}" SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}" SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}" SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}" SelectionCheckMarkVisualEnabled="False" SelectionIndicatorVisualEnabled="True" ContentMargin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Panel tab: SelectorBarItem with a 2 px accent underline (resources above, brushes aliased from tokens). -->
  <Style x:Key="YaapicPanelTabStyle" TargetType="SelectorBarItem" BasedOn="{StaticResource DefaultSelectorBarItemStyle}">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,18,0"/>
  </Style>

  <!-- Segmented control item: raised pill with a 1 px border when selected. -->
  <Style x:Key="YaapicSegmentedItemStyle" TargetType="ListViewItem">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="10,2"/>
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeBodySm}"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextSecondaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="Pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="{StaticResource YaapicRadiusSm}" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Content.Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"/>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Pill.Background" Value="{ThemeResource YaapicSurfaceElevatedBrush}"/>
                    <Setter Target="Pill.BorderBrush" Value="{ThemeResource YaapicBorderDefaultBrush}"/>
                    <Setter Target="Content.Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOverSelected">
                  <VisualState.Setters>
                    <Setter Target="Pill.Background" Value="{ThemeResource YaapicSurfaceElevatedBrush}"/>
                    <Setter Target="Pill.BorderBrush" Value="{ThemeResource YaapicBorderDefaultBrush}"/>
                    <Setter Target="Content.Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PressedSelected">
                  <VisualState.Setters>
                    <Setter Target="Pill.Background" Value="{ThemeResource YaapicSurfaceElevatedBrush}"/>
                    <Setter Target="Pill.BorderBrush" Value="{ThemeResource YaapicBorderDefaultBrush}"/>
                    <Setter Target="Content.Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control (Pretty/Raw): a horizontal ListView in a sunken, bordered, rounded frame. -->
  <Style x:Key="YaapicSegmentedStyle" TargetType="ListView">
    <Setter Property="ItemContainerStyle" Value="{StaticResource YaapicSegmentedItemStyle}"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListView">
          <Border Background="{ThemeResource YaapicSurfaceSunkenBrush}" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource YaapicRadiusMd}" Padding="2">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Status chip frame; its text uses YaapicChipTextStyle, the colours come from BrushMap. -->
  <Style x:Key="YaapicChipBorderStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusSm}"/>
    <Setter Property="Padding" Value="7,1"/>
  </Style>
  <Style x:Key="YaapicChipTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource YaapicMonoFont}"/>
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeBodySm}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Environment pill: 28 px, fully rounded, outlined; content is a dot, the name and a chevron. -->
  <Style x:Key="YaapicPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{ThemeResource YaapicBorderDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Count badge: the badge text with a tertiary colour; the active-tab variant uses the accent text colour. -->
  <Style x:Key="YaapicCountBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource YaapicBadgeTextStyle}"/>
  <Style x:Key="YaapicCountBadgeActiveTextStyle" TargetType="TextBlock" BasedOn="{StaticResource YaapicBadgeTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource YaapicAccentTextBrush}"/>
  </Style>

  <!-- Feedback: InfoBar frame and progress (2 px line, accent fill). InfoBar and ProgressRing have no stock style key to inherit, so theirs are keyed and applied per use. -->
  <Style x:Key="YaapicInfoBarStyle" TargetType="InfoBar">
    <Setter Property="CornerRadius" Value="{StaticResource YaapicRadiusMd}"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
    <Setter Property="Height" Value="2"/>
    <Setter Property="MinHeight" Value="2"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicAccentFillBrush}"/>
    <Setter Property="Background" Value="{ThemeResource YaapicBorderSubtleBrush}"/>
  </Style>
  <Style x:Key="YaapicProgressRingStyle" TargetType="ProgressRing">
    <Setter Property="Foreground" Value="{ThemeResource YaapicAccentFillBrush}"/>
  </Style>

  <!-- Loading placeholder bar. -->
  <Style x:Key="YaapicSkeletonBarStyle" TargetType="Border">
    <Setter Property="Height" Value="10"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Background" Value="{ThemeResource YaapicSurfaceRaisedBrush}"/>
  </Style>

  <Style x:Key="YaapicDialogBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource YaapicBodyTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextSecondaryBrush}"/>
  </Style>
  <!-- Dialog: 8 px corners; surfaces, border and separator come from the ContentDialog aliases. -->
  <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
  </Style>

  <!-- Request tab strip: 36 px, square tabs, tight padding; colours come from the generated TabView* aliases. -->
  <x:Double x:Key="YaapicTabBarHeight">36</x:Double>
  <x:Double x:Key="TabViewItemMinHeight">36</x:Double>
  <x:Double x:Key="TabViewItemMaxWidth">210</x:Double>
  <x:Double x:Key="TabViewItemMinWidth">80</x:Double>
  <Thickness x:Key="TabViewItemHeaderPadding">12,0,10,0</Thickness>
  <Thickness x:Key="TabViewItemHeaderPaddingWithCloseButton">12,0,6,0</Thickness>
  <Thickness x:Key="TabViewItemHeaderPaddingWithoutCloseButton">12,0,10,0</Thickness>
  <Thickness x:Key="TabViewItemHeaderCloseMargin">6,0,0,0</Thickness>
  <x:Double x:Key="TabViewItemHeaderCloseButtonWidth">20</x:Double>
  <x:Double x:Key="TabViewItemHeaderCloseButtonHeight">20</x:Double>
  <Thickness x:Key="TabViewItemSeparatorMargin">0</Thickness>



  <!-- Keycap hint ("Ctrl+T"): 1 px border, 2 px bottom edge, radius 4. -->
  <Style x:Key="YaapicKeycapBorderStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource YaapicBorderDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1,1,1,2"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,1"/>
  </Style>

  <!-- Tab name: body metrics without a Foreground, so the tab states (secondary, primary when selected) colour it. -->
  <Style x:Key="YaapicTabNameTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeBody}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightBody}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

</ResourceDictionary>
