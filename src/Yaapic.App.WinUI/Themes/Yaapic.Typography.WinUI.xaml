<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Sizes, line heights and brushes come from the generated Yaapic.Colors dictionary; weights must match the token file. -->
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <x:Double x:Key="ContentControlFontSize">13</x:Double>

  <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeBody}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightBody}"/>
  </Style>

  <Style x:Key="YaapicTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeTitle}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightTitle}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
  </Style>
  <Style x:Key="YaapicSubtitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeSubtitle}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightSubtitle}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
  </Style>
  <Style x:Key="YaapicBodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeBody}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightBody}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
  </Style>
  <Style x:Key="YaapicBodyStrongTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeBodyStrong}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightBodyStrong}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
  </Style>
  <Style x:Key="YaapicBodySmallTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeBodySm}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightBodySm}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextSecondaryBrush}"/>
  </Style>
  <Style x:Key="YaapicCaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeCaption}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightCaption}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextTertiaryBrush}"/>
  </Style>
  <Style x:Key="YaapicCodeTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource YaapicMonoFont}"/>
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeCode}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightCode}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextPrimaryBrush}"/>
  </Style>
  <Style x:Key="YaapicCodeSmallTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource YaapicMonoFont}"/>
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeCodeSm}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightCodeSm}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextSecondaryBrush}"/>
  </Style>
  <!-- Foreground is set by the caller (method brush). -->
  <Style x:Key="YaapicMethodTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource YaapicMonoFont}"/>
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeLabelMono}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightLabelMono}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="YaapicBadgeTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource YaapicMonoFont}"/>
    <Setter Property="FontSize" Value="{StaticResource YaapicFontSizeLabelMono}"/>
    <Setter Property="LineHeight" Value="{StaticResource YaapicLineHeightLabelMono}"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{ThemeResource YaapicTextTertiaryBrush}"/>
  </Style>
</ResourceDictionary>
