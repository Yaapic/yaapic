<Window x:Class="Yaapic.App.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yaapic">
  <Window.SystemBackdrop>
    <MicaBackdrop/>
  </Window.SystemBackdrop>
  <Grid x:Name="Root" Background="{ThemeResource YaapicSurfaceAppBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="40" Background="Transparent">
      <TextBlock Text="Yaapic" VerticalAlignment="Center" Margin="16,0,0,0"
                 Foreground="{ThemeResource YaapicTextPrimaryBrush}"/>
    </Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="Yaapic" FontSize="32" Foreground="{ThemeResource YaapicTextPrimaryBrush}"/>
      <TextBlock Text="Empty themed window" Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Dark" Click="OnThemeDark"/>
        <Button Content="Light" Click="OnThemeLight"/>
        <Button Content="System" Click="OnThemeSystem"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
