<Window x:Class="Yaapic.App.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Yaapic.App.WinUI.Presentation"
        xmlns:ic="using:FluentIcons.WinUI"
        xmlns:v="using:Yaapic.App.WinUI.Views"
        xmlns:req="using:Yaapic.ViewModels.Requests"
        xmlns:col="using:Yaapic.ViewModels.Collections"
        Title="Yaapic">
  <Window.SystemBackdrop>
    <MicaBackdrop/>
  </Window.SystemBackdrop>
  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden" Background="{ThemeResource YaapicSurfaceAppBrush}">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTab"/>
      <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTab"/>
      <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveTab"/>
      <KeyboardAccelerator Key="E" Modifiers="Control,Shift" Invoked="OnEnvironmentsShortcut"/>
      <KeyboardAccelerator Key="F" Modifiers="Control,Shift" Invoked="OnFilterShortcut"/>
      <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnPaletteShortcut"/>
      <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnPaletteShortcut"/>
      <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnPaletteShortcut"/>
      <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="OnNextTabShortcut"/>
      <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnPreviousTabShortcut"/>
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="48"
          Background="{ThemeResource YaapicSurfaceAppBrush}"
          BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="140"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
        <Viewbox Width="18" Height="18">
          <Canvas Width="24" Height="24">
            <Path Data="M5.5 4.5l6.3 8.2" StrokeThickness="2.6" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{ThemeResource YaapicTextPrimaryBrush}"/>
            <Path Data="M18.5 4.5l-7.4 12.8a2.6 2.6 0 0 1-2.3 1.3H5.2M7.6 16.1l-2.5 2.5 2.5 2.5" StrokeThickness="2.6" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{ThemeResource YaapicAccentTextBrush}"/>
          </Canvas>
        </Viewbox>
        <TextBlock Text="Yaapic" VerticalAlignment="Center" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
      </StackPanel>
      <Button x:Name="EnvironmentPill" Grid.Column="2" Style="{StaticResource YaapicPillButtonStyle}"
              VerticalAlignment="Center" Margin="0,0,8,0"
              AutomationProperties.Name="Environment">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Grid Width="8" Height="8" VerticalAlignment="Center">
            <Ellipse Fill="{ThemeResource YaapicSuccessBrush}"
                     Visibility="{x:Bind p:VisibilityMap.WhenNotNull(ViewModel.Environments.ActiveEnvironment), Mode=OneWay}"/>
            <Ellipse Fill="{ThemeResource YaapicTextTertiaryBrush}"
                     Visibility="{x:Bind p:VisibilityMap.WhenNull(ViewModel.Environments.ActiveEnvironment), Mode=OneWay}"/>
          </Grid>
          <TextBlock Text="{x:Bind ViewModel.Environments.ActiveEnvironment.Name, Mode=OneWay, FallbackValue='No environment', TargetNullValue='No environment'}"
                     VerticalAlignment="Center" Style="{StaticResource YaapicBodyTextStyle}"/>
          <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" IconSize="Size12" Foreground="{ThemeResource YaapicTextTertiaryBrush}"/>
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout x:Name="EnvironmentMenu" Opening="OnEnvironmentMenuOpening"/>
        </Button.Flyout>
      </Button>
    </Grid>
    <StackPanel Grid.Row="1">
      <InfoBar Severity="Error" IsClosable="False"
               IsOpen="{x:Bind p:VisibilityMap.HasText(ViewModel.Tabs.LastError), Mode=OneWay}"
               Message="{x:Bind ViewModel.Tabs.LastError, Mode=OneWay}"/>
      <InfoBar Severity="Error" IsClosable="False"
               IsOpen="{x:Bind p:VisibilityMap.HasText(ViewModel.Environments.LastError), Mode=OneWay}"
               Message="{x:Bind ViewModel.Environments.LastError, Mode=OneWay}"/>
      <InfoBar Severity="Error" IsClosable="False"
               IsOpen="{x:Bind p:VisibilityMap.HasText(ViewModel.Collections.LastError), Mode=OneWay}"
               Message="{x:Bind ViewModel.Collections.LastError, Mode=OneWay}"/>
      <InfoBar Severity="Error" IsClosable="False"
               IsOpen="{x:Bind p:VisibilityMap.HasText(ViewModel.History.LastError), Mode=OneWay}"
               Message="{x:Bind ViewModel.History.LastError, Mode=OneWay}"/>
      <InfoBar Severity="Error" IsClosable="False"
               IsOpen="{x:Bind p:VisibilityMap.HasText(ViewModel.Palette.LastError), Mode=OneWay}"
               Message="{x:Bind ViewModel.Palette.LastError, Mode=OneWay}"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="272"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{ThemeResource YaapicSurfaceAppBrush}" BorderBrush="{ThemeResource YaapicBorderSubtleBrush}"
              BorderThickness="0,0,1,0" Padding="0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Spacing="4">
            <Grid>
              <Rectangle Width="3" Height="16" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                         VerticalAlignment="Center" Fill="{ThemeResource YaapicAccentFillBrush}"
                         Visibility="{x:Bind p:VisibilityMap.WhenCollections(ViewModel.Mode), Mode=OneWay}"/>
              <Border Width="36" Height="36" CornerRadius="6" Background="{ThemeResource YaapicSelectionBackgroundBrush}"
                      Visibility="{x:Bind p:VisibilityMap.WhenCollections(ViewModel.Mode), Mode=OneWay}"/>
              <Button Style="{StaticResource YaapicRailButtonStyle}" HorizontalAlignment="Center"
                      AutomationProperties.Name="Collections" ToolTipService.ToolTip="Collections"
                      Command="{x:Bind ViewModel.ShowCollectionsCommand, Mode=OneWay}">
                <Viewbox Width="20" Height="20">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource YiCollection}" StrokeThickness="1.8" StrokeLineJoin="Round"
                          Stroke="{x:Bind p:BrushMap.CollectionsRail(ViewModel.Mode), Mode=OneWay}"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
            <Grid>
              <Rectangle Width="3" Height="16" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                         VerticalAlignment="Center" Fill="{ThemeResource YaapicAccentFillBrush}"
                         Visibility="{x:Bind p:VisibilityMap.WhenHistory(ViewModel.Mode), Mode=OneWay}"/>
              <Border Width="36" Height="36" CornerRadius="6" Background="{ThemeResource YaapicSelectionBackgroundBrush}"
                      Visibility="{x:Bind p:VisibilityMap.WhenHistory(ViewModel.Mode), Mode=OneWay}"/>
              <Button Style="{StaticResource YaapicRailButtonStyle}" HorizontalAlignment="Center"
                      AutomationProperties.Name="History" ToolTipService.ToolTip="History"
                      Command="{x:Bind ViewModel.ShowHistoryCommand, Mode=OneWay}">
                <Viewbox Width="20" Height="20">
                  <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource YiHistory}" StrokeThickness="1.8" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{x:Bind p:BrushMap.HistoryRail(ViewModel.Mode), Mode=OneWay}"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
            <Button Style="{StaticResource YaapicRailButtonStyle}" HorizontalAlignment="Center"
                    AutomationProperties.Name="Environments" ToolTipService.ToolTip="Environments (Ctrl+Shift+E)"
                    Click="OnManageEnvironments">
              <ic:FluentIcon Icon="Globe" IconVariant="Regular" IconSize="Size20"/>
            </Button>
            <Button Style="{StaticResource YaapicRailButtonStyle}" HorizontalAlignment="Center"
                    AutomationProperties.Name="Command palette" ToolTipService.ToolTip="Command palette (Ctrl+P)"
                    Command="{x:Bind ViewModel.OpenPaletteCommand}">
              <ic:FluentIcon Icon="Search" IconVariant="Regular" IconSize="Size20"/>
            </Button>
          </StackPanel>
          <Button Grid.Row="2" Style="{StaticResource YaapicRailButtonStyle}" HorizontalAlignment="Center"
                  AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
            <ic:FluentIcon Icon="Settings" IconVariant="Regular" IconSize="Size20"/>
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Dark theme" Click="OnThemeDark"/>
                <MenuFlyoutItem Text="Light theme" Click="OnThemeLight"/>
                <MenuFlyoutItem Text="System theme" Click="OnThemeSystem"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Background="{ThemeResource YaapicSurfaceSidebarBrush}"
            BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Padding="14,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Requests" VerticalAlignment="Center" Style="{StaticResource YaapicBodyStrongTextStyle}"
                     Visibility="{x:Bind p:VisibilityMap.WhenCollections(ViewModel.Mode), Mode=OneWay}"/>
          <TextBlock Text="History" VerticalAlignment="Center" Style="{StaticResource YaapicBodyStrongTextStyle}"
                     Visibility="{x:Bind p:VisibilityMap.WhenHistory(ViewModel.Mode), Mode=OneWay}"/>
          <Button Grid.Column="1" Style="{StaticResource YaapicIconButtonStyle}" AutomationProperties.Name="New request"
                  ToolTipService.ToolTip="New request or collection"
                  Visibility="{x:Bind p:VisibilityMap.WhenCollections(ViewModel.Mode), Mode=OneWay}">
            <ic:FluentIcon Icon="Add" IconVariant="Regular" IconSize="Size16"/>
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="New request" Command="{x:Bind ViewModel.Collections.NewRequestCommand, Mode=OneWay}"/>
                <MenuFlyoutItem Text="New collection" Command="{x:Bind ViewModel.Collections.NewCollectionCommand, Mode=OneWay}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <v:HistoryView Grid.Row="1" Grid.RowSpan="2" ViewModel="{x:Bind ViewModel.History, Mode=OneWay}"
                       Visibility="{x:Bind p:VisibilityMap.WhenHistory(ViewModel.Mode), Mode=OneWay}"/>
        <Grid Grid.Row="1" Padding="10,0,10,8"
              Visibility="{x:Bind p:VisibilityMap.WhenCollections(ViewModel.Mode), Mode=OneWay}">
          <TextBox x:Name="FilterBox" Height="28" MinHeight="28" Padding="28,3,84,3" PlaceholderText="Filter requests"
                   AutomationProperties.Name="Filter requests"
                   Background="{ThemeResource YaapicSurfaceSunkenBrush}"
                   Text="{x:Bind ViewModel.Collections.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <ic:FluentIcon Icon="Search" IconVariant="Regular" IconSize="Size16" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" Foreground="{ThemeResource YaapicTextTertiaryBrush}"/>
          <TextBlock Text="Ctrl+Shift+F" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                     IsHitTestVisible="False" Style="{StaticResource YaapicCodeSmallTextStyle}"
                     Foreground="{ThemeResource YaapicTextTertiaryBrush}"/>
        </Grid>
        <TreeView x:Name="CollectionTree" Grid.Row="2" SelectionMode="Single"
                  Visibility="{x:Bind p:VisibilityMap.WhenCollections(ViewModel.Mode), Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Collections.Roots, Mode=OneWay}"
                  ItemInvoked="OnNodeInvoked" ContextRequested="OnNodeContextRequested" KeyDown="OnTreeKeyDown">
          <TreeView.ItemTemplate>
            <DataTemplate x:DataType="col:CollectionNodeViewModel">
              <TreeViewItem AutomationProperties.Name="{x:Bind Name}" ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" MinHeight="26">
                <Grid ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind Url}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Viewbox Width="16" Height="16" VerticalAlignment="Center"
                           Visibility="{x:Bind p:VisibilityMap.WhenTrue(IsCollection)}">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource YiCollection}" Stroke="{ThemeResource YaapicTextSecondaryBrush}"
                            StrokeThickness="1.8" StrokeLineJoin="Round"/>
                    </Canvas>
                  </Viewbox>
                  <Viewbox Width="16" Height="16" VerticalAlignment="Center"
                           Visibility="{x:Bind p:VisibilityMap.WhenSubfolder(IsFolder, IsCollection)}">
                    <Canvas Width="24" Height="24">
                      <Path Data="{StaticResource YiFolder}" Stroke="{ThemeResource YaapicTextSecondaryBrush}"
                            StrokeThickness="1.8" StrokeLineJoin="Round"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock Width="52" Text="{x:Bind MethodText}" VerticalAlignment="Center"
                             Visibility="{x:Bind p:VisibilityMap.WhenFalse(IsFolder)}"
                             Style="{StaticResource YaapicMethodTextStyle}"
                             p:MethodBrush.Method="{x:Bind Method}"/>
                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Style="{StaticResource YaapicBodyTextStyle}"/>
                </Grid>
              </TreeViewItem>
            </DataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,24,16,0" Spacing="8"
                    Visibility="{x:Bind p:VisibilityMap.WhenCollectionsEmpty(ViewModel.Mode, ViewModel.Collections.IsEmpty), Mode=OneWay}">
          <TextBlock Text="No collections yet" HorizontalAlignment="Center"
                     Style="{StaticResource YaapicBodySmallTextStyle}"/>
          <Button Content="New request" HorizontalAlignment="Center" Click="OnAddTab"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="2">
        <TabView IsAddTabButtonVisible="False" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                 TabItemsSource="{x:Bind ViewModel.Tabs.Tabs, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.Tabs.ActiveTab, Mode=TwoWay}"
                 TabCloseRequested="OnTabCloseRequested">
          <TabView.TabStripFooter>
            <Button Style="{StaticResource YaapicIconButtonStyle}" Width="36" Height="36" MinHeight="36" CornerRadius="0"
                    HorizontalAlignment="Left" AutomationProperties.Name="New tab"
                    ToolTipService.ToolTip="New tab (Ctrl+T)" Click="OnAddTab">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M12 5v14M5 12h14" Stroke="{ThemeResource YaapicTextSecondaryBrush}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Button>
          </TabView.TabStripFooter>
          <TabView.TabItemTemplate>
            <DataTemplate x:DataType="req:RequestEditorViewModel">
              <TabViewItem Style="{StaticResource YaapicTabViewItemStyle}" VerticalContentAlignment="Center"
                           AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                <TabViewItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource YaapicMethodTextStyle}" VerticalAlignment="Center"
                               Text="{x:Bind MethodText, Mode=OneWay}"
                               p:MethodBrush.Method="{x:Bind Method, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource YaapicTabNameTextStyle}" Text="{x:Bind DisplayName, Mode=OneWay}"/>
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource YaapicAccentTextBrush}"
                             AutomationProperties.Name="Unsaved changes"
                             Visibility="{x:Bind p:VisibilityMap.WhenTrue(IsDirty), Mode=OneWay}"/>
                  </StackPanel>
                </TabViewItem.Header>
                <v:RequestEditorView ViewModel="{x:Bind}" SaveRequested="OnEditorSaveRequested"
                                     VariableScopeOpenRequested="OnVariableScopeOpenRequested"/>
              </TabViewItem>
            </DataTemplate>
          </TabView.TabItemTemplate>
        </TabView>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.Tabs.IsEmpty), Mode=OneWay}">
          <Viewbox Width="110" Height="76" HorizontalAlignment="Center">
            <Canvas Width="120" Height="84">
              <Path Data="M20 72h80" Stroke="{ThemeResource YaapicBorderOverlayBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M46.1 15.9l13.86 18.04" Stroke="{ThemeResource YaapicBorderOverlayBrush}" StrokeThickness="2.2"
                    StrokeDashArray="2 1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M74.7 15.9l-16.28 28.16a5.72 5.72 0 0 1-5.06 2.86H45.44M50.72 41.42l-5.5 5.5 5.5 5.5"
                    Stroke="{ThemeResource YaapicBorderOverlayBrush}" StrokeThickness="2.2"
                    StrokeDashArray="2 1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M92 18h10M96 12l4-4M98 24h8" Stroke="{ThemeResource YaapicAccentBorderBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Viewbox>
          <TextBlock Text="No request open." Style="{StaticResource YaapicSubtitleTextStyle}" HorizontalAlignment="Center"/>
          <TextBlock Text="Create a request, or open a saved one from the list." Style="{StaticResource YaapicBodyTextStyle}"
                     Foreground="{ThemeResource YaapicTextSecondaryBrush}" MaxWidth="320" TextWrapping="Wrap"
                     TextAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="New request" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.Requests.NewRequestCommand, Mode=OneWay}"/>
            <Border Style="{StaticResource YaapicKeycapBorderStyle}" VerticalAlignment="Center">
              <TextBlock Text="Ctrl+T" Style="{StaticResource YaapicCodeSmallTextStyle}"
                         Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
    <v:CommandPaletteView Grid.RowSpan="3" ViewModel="{x:Bind ViewModel.Palette, Mode=OneWay}"/>
  </Grid>
</Window>
