<ContentDialog
    xmlns:loc="using:Yaapic.Localization" x:Class="Yaapic.App.WinUI.Views.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:Yaapic.App.WinUI.Presentation"
    xmlns:v="using:Yaapic.App.WinUI.Views"
    xmlns:i="using:Yaapic.ViewModels.Import"
    Title="{x:Bind loc:Strings.ImportTitle}">
  <ContentDialog.Resources>
    <!-- The default 548 px cap clips a 720 px body. -->
    <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
  </ContentDialog.Resources>
  <Grid Width="720" Height="560" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{x:Bind loc:Strings.ImportChooseFile}" AutomationProperties.Name="{x:Bind loc:Strings.ImportChooseFile}"
              Command="{x:Bind ViewModel.ChooseFileCommand}"/>
      <Button Content="{x:Bind loc:Strings.ImportChooseFolder}" AutomationProperties.Name="{x:Bind loc:Strings.ImportChooseFolder}"
              Command="{x:Bind ViewModel.ChooseFolderCommand}"/>
      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                 Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="72" FontFamily="Consolas"
               PlaceholderText="{x:Bind loc:Strings.ImportPasteHint}" AutomationProperties.Name="{x:Bind loc:Strings.ImportPasteHint}"
               Text="{x:Bind ViewModel.PastedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{x:Bind loc:Strings.ImportPreview}"
              AutomationProperties.Name="{x:Bind loc:Strings.ImportPreview}" Command="{x:Bind ViewModel.PreviewPastedCommand}"/>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ComboBox HorizontalAlignment="Stretch" Header="{x:Bind loc:Strings.ImportFormat}"
                AutomationProperties.Name="{x:Bind loc:Strings.ImportFormat}"
                ItemsSource="{x:Bind p:ListMap.ImportFormats(ViewModel.Formats)}"
                SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="i:ImportFormatChoice">
            <TextBlock Text="{x:Bind Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6" TextWrapping="Wrap"
                 Text="{x:Bind p:TextMap.ImportDetected(ViewModel.DetectedFormat), Mode=OneWay}"/>
    </Grid>
    <CheckBox Grid.Row="3" Content="{x:Bind loc:Strings.ImportIncludeStatic}" AutomationProperties.Name="{x:Bind loc:Strings.ImportIncludeStatic}"
              IsChecked="{x:Bind ViewModel.IncludeStaticResources, Mode=TwoWay}"
              Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowStaticResourcesOption), Mode=OneWay}"/>
    <TextBlock Grid.Row="4" TextWrapping="Wrap" Style="{StaticResource YaapicBodyStrongTextStyle}"
               Text="{x:Bind p:TextMap.ImportCounts(ViewModel.Folders, ViewModel.Requests, ViewModel.Environments, ViewModel.GlobalVariables), Mode=OneWay}"
               Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.HasPreview), Mode=OneWay}"/>
    <v:ImportReportView Grid.Row="5" ViewModel="{x:Bind ViewModel.Report}"/>
    <Grid Grid.Row="6" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource YaapicDangerBrush}"
                 Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Visibility="{x:Bind p:VisibilityMap.WhenText(ViewModel.Error), Mode=OneWay}"/>
      <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsBusy), Mode=OneWay}"/>
    </Grid>
    <Grid Grid.Row="7" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                 Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"/>
      <Button Grid.Column="1" MinWidth="96" Style="{StaticResource AccentButtonStyle}"
              Content="{x:Bind loc:Strings.ImportTitle}" AutomationProperties.Name="{x:Bind loc:Strings.ImportTitle}"
              Command="{x:Bind ViewModel.ImportCommand}"/>
      <Button Grid.Column="2" MinWidth="96" Content="{x:Bind loc:Strings.CommonClose}" AutomationProperties.Name="{x:Bind loc:Strings.CommonClose}"
              Click="OnCloseClick"/>
    </Grid>
  </Grid>
</ContentDialog>
