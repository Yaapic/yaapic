<UserControl x:Class="Yaapic.App.WinUI.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Yaapic.App.WinUI.Presentation"
             xmlns:v="using:Yaapic.App.WinUI.Views">
  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendAccelerator"/>
  </UserControl.KeyboardAccelerators>
  <Grid RowSpacing="8" Padding="16,8,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBox PlaceholderText="Request name" BorderThickness="0" Background="Transparent"
               FontSize="20" FontWeight="SemiBold"
               Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Grid Grid.Row="1" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="MethodBox" Width="100" AutomationProperties.Name="Method"
                  SelectionChanged="OnMethodChanged">
          <ComboBoxItem Content="GET" Foreground="{ThemeResource YaapicMethodGetBrush}"/>
          <ComboBoxItem Content="POST" Foreground="{ThemeResource YaapicMethodPostBrush}"/>
        </ComboBox>
        <TextBox Grid.Column="1" PlaceholderText="Enter URL or paste text"
                 FontFamily="{StaticResource YaapicMonoFont}"
                 FontSize="{StaticResource YaapicCodeFontSize}"
                 Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Grid.Column="2" Content="Send" Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
                Visibility="{x:Bind p:VisibilityMap.WhenFalse(ViewModel.IsSending), Mode=OneWay}"/>
        <Button Grid.Column="2" Content="Cancel"
                Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsSending), Mode=OneWay}"/>
      </Grid>
      <SelectorBar Grid.Row="2" SelectionChanged="OnTabChanged">
        <SelectorBarItem Text="Params" IsSelected="True"/>
        <SelectorBarItem Text="Headers"/>
        <SelectorBarItem Text="Body"/>
      </SelectorBar>
      <Grid Grid.Row="3">
        <v:KeyValueEditorView x:Name="ParamsPane" ViewModel="{x:Bind ViewModel.QueryParams, Mode=OneWay}"/>
        <v:KeyValueEditorView x:Name="HeadersPane" Visibility="Collapsed"
                              ViewModel="{x:Bind ViewModel.Headers, Mode=OneWay}"/>
        <Grid x:Name="BodyPane" Visibility="Collapsed" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButtons x:Name="BodyKinds" MaxColumns="2" SelectionChanged="OnBodyKindChanged">
              <x:String>None</x:String>
              <x:String>Raw</x:String>
            </RadioButtons>
            <ComboBox x:Name="ContentTypeBox" VerticalAlignment="Top" Width="100"
                      AutomationProperties.Name="Content type"
                      SelectionChanged="OnContentTypeChanged"
                      Visibility="{x:Bind p:VisibilityMap.WhenRaw(ViewModel.BodyKind), Mode=OneWay}">
              <ComboBoxItem Content="JSON"/>
              <ComboBoxItem Content="Text"/>
              <ComboBoxItem Content="XML"/>
            </ComboBox>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="GET requests are sent without a body"
                     Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                     Visibility="{x:Bind p:VisibilityMap.WhenGet(ViewModel.Method), Mode=OneWay}"/>
          <TextBox Grid.Row="2" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="{StaticResource YaapicMonoFont}"
                   FontSize="{StaticResource YaapicCodeFontSize}"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Visibility="{x:Bind p:VisibilityMap.WhenRaw(ViewModel.BodyKind), Mode=OneWay}"
                   Text="{x:Bind ViewModel.BodyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
      </Grid>
    </Grid>
    <v:ResponsePanelView Grid.Row="1" ViewModel="{x:Bind ViewModel.Response, Mode=OneWay}"/>
  </Grid>
</UserControl>
