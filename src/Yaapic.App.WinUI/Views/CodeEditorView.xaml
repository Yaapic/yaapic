<UserControl x:Class="Yaapic.App.WinUI.Views.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Borderless: the containers draw the frame, so every TextBox state is flat. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
  </UserControl.Resources>
  <!-- Fallback for ADR 0002: LoomEditor.WinUI is rejected (see docs/dependencies.md), so no line numbers or colours. -->
  <TextBox x:Name="Box" AcceptsReturn="True" TextWrapping="NoWrap" Padding="16,0" MinHeight="0"
           FontFamily="{StaticResource YaapicMonoFont}" FontSize="{StaticResource YaapicFontSizeCode}"
           AutomationProperties.Name="Code editor"
           ScrollViewer.HorizontalScrollBarVisibility="Auto"
           ScrollViewer.VerticalScrollBarVisibility="Auto"
           TextChanged="OnBoxTextChanged"/>
</UserControl>
