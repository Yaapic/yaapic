<ContentDialog x:Class="Yaapic.App.WinUI.Views.EnvironmentsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:p="using:Yaapic.App.WinUI.Presentation"
               xmlns:env="using:Yaapic.ViewModels.Environments"
               xmlns:v="using:Yaapic.App.WinUI.Views"
               xmlns:ic="using:FluentIcons.WinUI"
               PrimaryButtonText="Save" PrimaryButtonStyle="{StaticResource AccentButtonStyle}" PrimaryButtonClick="OnPrimaryButtonClick"
               CloseButtonText="Close" DefaultButton="None" CloseButtonStyle="{StaticResource YaapicDialogButtonStyle}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
    <Thickness x:Key="ContentDialogCommandSpaceMargin">0</Thickness>
    <Style x:Key="EnvironmentRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource YaapicListRowStyle}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="14,0"/>
    </Style>
  </ContentDialog.Resources>
  <Grid x:Name="Body" Width="960" Height="560">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Background="{ThemeResource YaapicSurfaceSidebarBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Padding="14,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Environments" VerticalAlignment="Center" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
        <Button Grid.Column="1" Style="{StaticResource YaapicIconButtonStyle}" Command="{x:Bind ViewModel.AddCommand}"
                AutomationProperties.Name="New environment" ToolTipService.ToolTip="New environment">
          <ic:FluentIcon Icon="Add" IconVariant="Regular" IconSize="Size16"/>
        </Button>
      </Grid>
      <Button Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="32" Padding="14,0"
              CornerRadius="0" Style="{StaticResource YaapicSubtleButtonStyle}"
              Background="{x:Bind p:EnvironmentMap.RowBackground(ViewModel.IsEditingGlobals), Mode=OneWay}"
              Click="OnSelectGlobals" AutomationProperties.Name="Globals">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Globals" VerticalAlignment="Center" Style="{StaticResource YaapicBodyTextStyle}"
                     FontWeight="{x:Bind p:EnvironmentMap.Weight(ViewModel.IsEditingGlobals), Mode=OneWay}"/>
          <TextBlock Grid.Column="1" Text="&#x2022;" VerticalAlignment="Center"
                     Foreground="{ThemeResource YaapicAccentFillBrush}" AutomationProperties.Name="Unsaved changes"
                     Visibility="{x:Bind p:VisibilityMap.WhenTrue(Globals.IsDirty), Mode=OneWay}"/>
        </Grid>
      </Button>
      <ListView Grid.Row="2" SelectionMode="Single" ItemContainerStyle="{StaticResource EnvironmentRowStyle}"
                ItemsSource="{x:Bind ViewModel.Environments, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.EditedEnvironment, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="env:EnvironmentItemViewModel">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{x:Bind p:EnvironmentMap.Dot(IsActive), Mode=OneWay}"/>
              <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Style="{StaticResource YaapicBodyTextStyle}"
                         FontWeight="{x:Bind p:EnvironmentMap.Weight(IsEdited), Mode=OneWay}"/>
              <Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{ThemeResource YaapicAccentFillBrush}"
                       AutomationProperties.Name="Unsaved changes"
                       Visibility="{x:Bind p:VisibilityMap.WhenTrue(IsDirty), Mode=OneWay}"/>
              <TextBlock Grid.Column="2" Text="active" VerticalAlignment="Center"
                         Style="{StaticResource YaapicCaptionTextStyle}"
                         Visibility="{x:Bind p:VisibilityMap.WhenTrue(IsActive), Mode=OneWay}"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
    <Border Grid.Column="1" Background="{ThemeResource YaapicBorderSubtleBrush}"/>
    <Grid Grid.Column="2" Background="{ThemeResource YaapicSurfaceBaseBrush}">
      <Grid Visibility="{x:Bind p:VisibilityMap.WhenNotNull(ViewModel.EditedEnvironment), Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Padding="20,0" ColumnSpacing="12" BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="60"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                   Fill="{x:Bind p:EnvironmentMap.Dot(ViewModel.EditedEnvironment.IsActive), Mode=OneWay}"/>
          <TextBox Grid.Column="1" MinHeight="36" Padding="0,4" VerticalAlignment="Center"
                   FontSize="20" FontWeight="SemiBold" PlaceholderText="Environment name"
                   AutomationProperties.Name="Environment name"
                   Text="{x:Bind ViewModel.EditedEnvironment.Name, Mode=TwoWay, FallbackValue='', UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
              <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,2</Thickness>
            </TextBox.Resources>
          </TextBox>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource YaapicBodySmallTextStyle}"
                     Foreground="{ThemeResource YaapicTextTertiaryBrush}"
                     Text="{x:Bind p:EnvironmentMap.VariableCount(ViewModel.EditedEnvironment.Variables.ActiveCount), Mode=OneWay}"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Style="{StaticResource YaapicIconButtonStyle}"
                    Command="{x:Bind ViewModel.DuplicateCommand}"
                    CommandParameter="{x:Bind ViewModel.EditedEnvironment, Mode=OneWay}"
                    AutomationProperties.Name="Duplicate" ToolTipService.ToolTip="Duplicate">
              <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16"/>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource YaapicDangerButtonStyle}"
                    AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete">
              <ic:FluentIcon Icon="Delete" IconVariant="Regular" IconSize="Size16"/>
              <Button.Flyout>
                <Flyout>
                  <StackPanel Spacing="8">
                    <TextBlock x:Name="DeletePrompt"/>
                    <Button Content="Delete" Style="{StaticResource YaapicDangerButtonStyle}" Click="OnConfirmDelete"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
        <v:KeyValueEditorView Grid.Row="1" x:Name="Variables" KeyHeader="Variable" Margin="20,12,20,16"/>
      </Grid>
      <Grid Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsEditingGlobals), Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Padding="20,0" BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="Globals" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="20,12,20,0" Spacing="8">
          <TextBlock Style="{StaticResource YaapicBodySmallTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                     Text="Available in every request; the active environment and the collection override them."/>
          <InfoBar Severity="Error" IsClosable="False"
                   IsOpen="{x:Bind p:VisibilityMap.HasText(Globals.LastError), Mode=OneWay}"
                   Message="{x:Bind Globals.LastError, Mode=OneWay}"/>
        </StackPanel>
        <v:KeyValueEditorView Grid.Row="2" x:Name="GlobalVariables" KeyHeader="Variable" Margin="20,12,20,16"/>
      </Grid>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select an environment, or add one."
                 Style="{StaticResource YaapicBodyTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                 Visibility="{x:Bind p:VisibilityMap.WhenNeither(ViewModel.IsEditingGlobals, ViewModel.EditedEnvironment), Mode=OneWay}"/>
    </Grid>
  </Grid>
</ContentDialog>
