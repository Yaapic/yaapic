<UserControl x:Class="Yaapic.App.WinUI.Views.VariableTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Host" Background="Transparent" SizeChanged="OnHostSizeChanged">
    <!-- A Canvas never layout-clips its child, so the long text can slide under the clip when the box scrolls. -->
    <Border x:Name="OverlayClip" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
      <Canvas x:Name="OverlayCanvas" SizeChanged="OnOverlayCanvasSizeChanged">
        <TextBlock x:Name="Overlay" IsHitTestVisible="False" TextWrapping="NoWrap"
                   AutomationProperties.AccessibilityView="Raw" SizeChanged="OnOverlayTextSizeChanged"
                   FontFamily="{StaticResource YaapicMonoFont}" FontSize="{StaticResource YaapicFontSizeBody}"
                   Foreground="{ThemeResource YaapicTextPrimaryBrush}">
          <TextBlock.RenderTransform>
            <TranslateTransform x:Name="OverlayShift"/>
          </TextBlock.RenderTransform>
        </TextBlock>
      </Canvas>
    </Border>
    <TextBox x:Name="Input" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MinHeight="0" VerticalContentAlignment="Center" TextWrapping="NoWrap" AcceptsReturn="False"
             FontFamily="{StaticResource YaapicMonoFont}" FontSize="{StaticResource YaapicFontSizeBody}"
             Foreground="Transparent" Background="Transparent"
             SelectionChanged="OnInputSelectionChanged" TextChanged="OnInputTextChanged" GotFocus="OnInputGotFocus" LostFocus="OnInputLostFocus" PreviewKeyDown="OnInputKeyDown">
      <TextBox.Resources>
        <!-- The host draws the frame and the overlay draws the text, so the box is flat and its own text is invisible in every state. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlForeground" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="Transparent"/>
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        
      </TextBox.Resources>
    </TextBox>
    <!-- The box paints its selection opaque over the (transparent) text: the selected text is drawn again in front of it. -->
    <Border x:Name="SelectionClip" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
      <Canvas x:Name="SelectionCanvas" SizeChanged="OnOverlayCanvasSizeChanged">
        <TextBlock x:Name="SelectionOverlay" IsHitTestVisible="False" TextWrapping="NoWrap"
                   AutomationProperties.AccessibilityView="Raw" SizeChanged="OnOverlayTextSizeChanged"
                   FontFamily="{StaticResource YaapicMonoFont}" FontSize="{StaticResource YaapicFontSizeBody}">
          <TextBlock.RenderTransform>
            <TranslateTransform x:Name="SelectionShift"/>
          </TextBlock.RenderTransform>
        </TextBlock>
      </Canvas>
    </Border>
    <Popup x:Name="VariablePopup" IsLightDismissEnabled="False"/>
  </Grid>
</UserControl>
