<ContentDialog
    xmlns:loc="using:Yaapic.Localization" x:Class="Yaapic.App.WinUI.Views.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:Yaapic.App.WinUI.Presentation"
    xmlns:v="using:Yaapic.App.WinUI.Views"
    xmlns:i="using:Yaapic.ViewModels.Import"
    Title="{x:Bind loc:Strings.ExportTitle}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
  </ContentDialog.Resources>
  <Grid Width="640" Height="520" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ComboBox HorizontalAlignment="Stretch" Header="{x:Bind loc:Strings.ExportCollection}"
              AutomationProperties.Name="{x:Bind loc:Strings.ExportCollection}"
              ItemsSource="{x:Bind p:ListMap.ExportChoices(ViewModel.Collections), Mode=OneWay}"
              SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=TwoWay}"
              Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.RequiresCollection), Mode=OneWay}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="i:ExportChoice">
          <TextBlock Text="{x:Bind Name}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
               Text="{x:Bind p:TextMap.ExportEmpty(ViewModel.RequiresCollection, ViewModel.Collections.Count), Mode=OneWay}"/>
    <ComboBox Grid.Row="2" HorizontalAlignment="Stretch" Header="{x:Bind loc:Strings.ExportFormat}"
              AutomationProperties.Name="{x:Bind loc:Strings.ExportFormat}"
              ItemsSource="{x:Bind p:ListMap.ExportFormats(ViewModel.Formats)}"
              SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="i:ExportFormatChoice">
          <TextBlock Text="{x:Bind DisplayName}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <StackPanel Grid.Row="3" Spacing="6" Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowEnvironments), Mode=OneWay}">
      <TextBlock Style="{StaticResource YaapicBodyStrongTextStyle}" Text="{x:Bind loc:Strings.ExportEnvironments}"/>
      <ListView MaxHeight="120" SelectionMode="None" AutomationProperties.Name="{x:Bind loc:Strings.ExportEnvironments}"
                ItemsSource="{x:Bind p:ListMap.ExportEnvironmentChoices(ViewModel.EnvironmentChoices), Mode=OneWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="i:ExportEnvironmentChoice">
            <CheckBox Content="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <CheckBox Content="{x:Bind loc:Strings.ExportIncludeGlobals}" AutomationProperties.Name="{x:Bind loc:Strings.ExportIncludeGlobals}"
                IsChecked="{x:Bind ViewModel.IncludeGlobals, Mode=TwoWay}"/>
    </StackPanel>
    <TextBlock Grid.Row="4" TextWrapping="Wrap" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
               Text="{x:Bind loc:Strings.ExportSecretsNote}"/>
    <v:ImportReportView Grid.Row="5" ViewModel="{x:Bind ViewModel.Report}"/>
    <Grid Grid.Row="6" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource YaapicDangerBrush}"
                 Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Visibility="{x:Bind p:VisibilityMap.WhenText(ViewModel.Error), Mode=OneWay}"/>
      <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsBusy), Mode=OneWay}"/>
    </Grid>
    <Grid Grid.Row="7" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                 Text="{x:Bind p:TextMap.ExportSaved(ViewModel.SavedName), Mode=OneWay}"/>
      <Button Grid.Column="1" MinWidth="96" Style="{StaticResource AccentButtonStyle}"
              Content="{x:Bind loc:Strings.ExportExport}" AutomationProperties.Name="{x:Bind loc:Strings.ExportExport}"
              Command="{x:Bind ViewModel.ExportCommand}"/>
      <Button Grid.Column="2" MinWidth="96" Content="{x:Bind loc:Strings.ExportClose}" AutomationProperties.Name="{x:Bind loc:Strings.ExportClose}"
              Click="OnCloseClick"/>
    </Grid>
  </Grid>
</ContentDialog>
