<UserControl
    x:Class="Yaapic.App.WinUI.Views.RunnerRequestListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Yaapic.Localization"
    xmlns:p="using:Yaapic.App.WinUI.Presentation"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:r="using:Yaapic.ViewModels.Runner"
    xmlns:m="using:Yaapic.ViewModels.Monitors">
  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox HorizontalAlignment="Stretch"
                  AutomationProperties.Name="{x:Bind loc:Strings.RunnerFolder}" PlaceholderText="{x:Bind loc:Strings.RunnerChooseFolder}"
                  IsEnabled="{x:Bind Setup.CanChooseFolder, Mode=OneWay}"
                  ItemsSource="{x:Bind p:ListMap.MonitorFolders(Setup.FolderChoices), Mode=OneWay}"
                  SelectedItem="{x:Bind Setup.SelectedFolder, Mode=OneWay}" SelectionChanged="OnFolderChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="m:MonitorFolderChoice">
              <TextBlock Text="{x:Bind Path}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                   Text="{x:Bind p:TextMap.RunnerSelected(Setup.SelectedCount, Setup.Items.Count), Mode=OneWay}"
                   Visibility="{x:Bind p:VisibilityMap.WhenTrue(Setup.HasFolder), Mode=OneWay}"/>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind p:VisibilityMap.WhenTrue(Setup.HasFolder), Mode=OneWay}">
        <HyperlinkButton Content="{x:Bind loc:Strings.RunnerSelectAll}" Command="{x:Bind Setup.SelectAllCommand}"/>
        <HyperlinkButton Content="{x:Bind loc:Strings.RunnerSelectNone}" Command="{x:Bind Setup.SelectNoneCommand}"/>
      </StackPanel>

      <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                 Text="{x:Bind loc:Strings.RunnerChooseFolder}"
                 Visibility="{x:Bind p:VisibilityMap.WhenFalse(Setup.HasFolder), Mode=OneWay}"/>

      <ListView Grid.Row="2" SelectionMode="None" Visibility="{x:Bind p:VisibilityMap.WhenTrue(Setup.HasFolder), Mode=OneWay}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerRequests}"
                ItemsSource="{x:Bind p:ListMap.RunnerItems(Setup.Items), Mode=OneWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="r:RunnerItemViewModel">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <CheckBox MinWidth="0" AutomationProperties.Name="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource YaapicCaptionTextStyle}" FontWeight="SemiBold"
                         p:MethodBrush.Method="{x:Bind Method}" Text="{x:Bind Method}"/>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource YaapicCaptionTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{x:Bind Path}"/>
              </StackPanel>
              <Button Grid.Column="3" Style="{StaticResource YaapicIconButtonStyle}" Tag="{x:Bind}" Click="OnMoveUp"
                      AutomationProperties.Name="{x:Bind loc:Strings.RunnerMoveUp}">
                <ic:FluentIcon Icon="ArrowUp" IconVariant="Regular" IconSize="Size16"/>
              </Button>
              <Button Grid.Column="4" Style="{StaticResource YaapicIconButtonStyle}" Tag="{x:Bind}" Click="OnMoveDown"
                      AutomationProperties.Name="{x:Bind loc:Strings.RunnerMoveDown}">
                <ic:FluentIcon Icon="ArrowDown" IconVariant="Regular" IconSize="Size16"/>
              </Button>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
  </Grid>
</UserControl>
