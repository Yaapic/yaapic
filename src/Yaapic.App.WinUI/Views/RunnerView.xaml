<UserControl
    xmlns:loc="using:Yaapic.Localization" x:Class="Yaapic.App.WinUI.Views.RunnerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:Yaapic.App.WinUI.Presentation"
    xmlns:v="using:Yaapic.App.WinUI.Views"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:r="using:Yaapic.ViewModels.Runner">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftColumn" Width="360" MinWidth="280" MaxWidth="640"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid Padding="12" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource YaapicBodyStrongTextStyle}" TextTrimming="CharacterEllipsis"
                   Text="{x:Bind ViewModel.Setup.FolderName, Mode=OneWay}"/>
        <TextBlock Grid.Column="1" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                   Text="{x:Bind p:TextMap.RunnerSelected(ViewModel.Setup.SelectedCount, ViewModel.Setup.Items.Count), Mode=OneWay}"/>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
        <HyperlinkButton Content="{x:Bind loc:Strings.RunnerSelectAll}" Command="{x:Bind ViewModel.Setup.SelectAllCommand}"/>
        <HyperlinkButton Content="{x:Bind loc:Strings.RunnerSelectNone}" Command="{x:Bind ViewModel.Setup.SelectNoneCommand}"/>
      </StackPanel>

      <ListView Grid.Row="2" SelectionMode="None" AutomationProperties.Name="{x:Bind loc:Strings.RunnerRequests}"
                ItemsSource="{x:Bind p:ListMap.RunnerItems(ViewModel.Setup.Items), Mode=OneWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="r:RunnerItemViewModel">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <CheckBox MinWidth="0" AutomationProperties.Name="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource YaapicCaptionTextStyle}" FontWeight="SemiBold"
                         p:MethodBrush.Method="{x:Bind Method}" Text="{x:Bind Method}"/>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource YaapicCaptionTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{x:Bind Path}"/>
              </StackPanel>
              <Button Grid.Column="3" Style="{StaticResource YaapicIconButtonStyle}" Tag="{x:Bind}" Click="OnMoveUp"
                      AutomationProperties.Name="{x:Bind loc:Strings.RunnerMoveUp}">
                <ic:FluentIcon Icon="ArrowUp" IconVariant="Regular" IconSize="Size16"/>
              </Button>
              <Button Grid.Column="4" Style="{StaticResource YaapicIconButtonStyle}" Tag="{x:Bind}" Click="OnMoveDown"
                      AutomationProperties.Name="{x:Bind loc:Strings.RunnerMoveDown}">
                <ic:FluentIcon Icon="ArrowDown" IconVariant="Regular" IconSize="Size16"/>
              </Button>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <Grid Grid.Row="3" ColumnSpacing="8" RowSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <NumberBox Header="{x:Bind loc:Strings.RunnerIterations}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerIterations}"
                   SpinButtonPlacementMode="Compact" Minimum="0" Maximum="100000"
                   Value="{x:Bind ViewModel.Setup.Iterations, Mode=OneWay}" ValueChanged="OnIterationsChanged"/>
        <NumberBox Grid.Column="1" Header="{x:Bind loc:Strings.RunnerDelay}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerDelay}"
                   SpinButtonPlacementMode="Compact" Minimum="-1" Maximum="1000000" SmallChange="100"
                   Value="{x:Bind ViewModel.Setup.DelayMs, Mode=OneWay}" ValueChanged="OnDelayChanged"/>
        <CheckBox Grid.Row="1" Content="{x:Bind loc:Strings.RunnerStopOnFailure}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerStopOnFailure}"
                  IsChecked="{x:Bind ViewModel.Setup.StopOnFailure, Mode=TwoWay}"/>
        <CheckBox Grid.Row="1" Grid.Column="1" Content="{x:Bind loc:Strings.RunnerPersistVariables}"
                  AutomationProperties.Name="{x:Bind loc:Strings.RunnerPersistVariables}"
                  IsChecked="{x:Bind ViewModel.Setup.PersistVariables, Mode=TwoWay}"/>
      </Grid>

      <StackPanel Grid.Row="4" Spacing="6">
        <TextBlock Style="{StaticResource YaapicBodyStrongTextStyle}" Text="{x:Bind loc:Strings.RunnerData}"/>
        <Button Content="{x:Bind loc:Strings.RunnerChooseData}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerChooseData}"
                Command="{x:Bind ViewModel.Setup.ChooseDataFileCommand}"/>
        <StackPanel Spacing="6" Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.Setup.HasData), Mode=OneWay}">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{x:Bind p:TextMap.RunnerData(ViewModel.Setup.DataFileName, ViewModel.Setup.DataRowCount, ViewModel.Setup.DataColumns.Count), Mode=OneWay}"/>
            <Button Grid.Column="1" Content="{x:Bind loc:Strings.RunnerClearData}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerClearData}"
                    Command="{x:Bind ViewModel.Setup.ClearDataCommand}"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="150">
            <StackPanel>
              <ItemsControl ItemsSource="{x:Bind p:ListMap.Lines(ViewModel.Setup.DataColumns), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Width="110" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource YaapicBodyStrongTextStyle}" Text="{x:Bind}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{x:Bind p:ListMap.DataRows(ViewModel.Setup.DataPreview), Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:DataPreviewRow">
                    <ItemsControl ItemsSource="{x:Bind p:ListMap.Lines(Cells)}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Width="110" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" Text="{x:Bind}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource YaapicDangerBrush}"
                   Text="{x:Bind ViewModel.Setup.DataError, Mode=OneWay}"
                   Visibility="{x:Bind p:VisibilityMap.WhenText(ViewModel.Setup.DataError), Mode=OneWay}"/>
      </StackPanel>

      <StackPanel Grid.Row="5" Spacing="8">
        <TextBlock TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource YaapicDangerBrush}"
                   Text="{x:Bind ViewModel.Setup.ValidationError, Mode=OneWay}"
                   Visibility="{x:Bind p:VisibilityMap.WhenText(ViewModel.Setup.ValidationError), Mode=OneWay}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button MinWidth="96" Content="{x:Bind loc:Strings.RunnerStop}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerStop}"
                  Command="{x:Bind ViewModel.StopCommand}"/>
          <Button MinWidth="96" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind loc:Strings.RunnerRun}"
                  AutomationProperties.Name="{x:Bind loc:Strings.RunnerRun}" Command="{x:Bind ViewModel.RunCommand}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Column="1">
      <Rectangle Width="1" HorizontalAlignment="Center" IsHitTestVisible="False" Fill="{ThemeResource YaapicBorderDefaultBrush}"/>
      <v:SplitterHandle x:Name="Splitter" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True"
                        PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"
                        PointerReleased="OnSplitterPointerReleased" PointerCanceled="OnSplitterPointerReleased"
                        PointerCaptureLost="OnSplitterPointerReleased" KeyDown="OnSplitterKeyDown">
        <v:SplitterHandle.Template>
          <ControlTemplate TargetType="Control">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </v:SplitterHandle.Template>
      </v:SplitterHandle>
    </Grid>

    <Border x:Name="ResultsHost" Grid.Column="2">
      <v:RunnerResultsView ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
    </Border>
  </Grid>
</UserControl>
