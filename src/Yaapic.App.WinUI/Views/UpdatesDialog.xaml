<ContentDialog
    xmlns:loc="using:Yaapic.Localization" x:Class="Yaapic.App.WinUI.Views.UpdatesDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:p="using:Yaapic.App.WinUI.Presentation"
               Title="{x:Bind loc:Strings.SettingsTitle}"
               CloseButtonText="{x:Bind loc:Strings.CommonClose}" DefaultButton="Close" CloseButtonStyle="{StaticResource YaapicDialogButtonStyle}">
  <ContentDialog.Resources>
    <SolidColorBrush x:Key="SwatchSelectedBrush" Color="{ThemeResource YaapicTextPrimaryColor}"/>
    <SolidColorBrush x:Key="SwatchIdleBrush" Color="{ThemeResource YaapicBorderDefaultColor}"/>
  </ContentDialog.Resources>
  <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
    <StackPanel Width="400" Spacing="16" Margin="0,0,12,0">
      <StackPanel Spacing="2">
        <TextBlock Text="Yaapic" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
        <TextBlock x:Name="VersionText" Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
        <TextBlock x:Name="TaglineText" TextWrapping="Wrap" Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
      </StackPanel>
      <StackPanel Spacing="12">
        <TextBlock x:Name="AppearanceTitle" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
        <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged"/>
        <StackPanel x:Name="RestartPanel" Spacing="8" Visibility="Collapsed">
          <TextBlock x:Name="RestartNote" TextWrapping="Wrap" Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
          <Button x:Name="RestartButton" Click="OnRestartClick"/>
        </StackPanel>
        <TextBlock x:Name="AccentTitle"/>
        <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="8"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="CustomBox" Width="200" MaxLength="7" TextChanged="OnCustomChanged"/>
          <Button x:Name="ApplyButton" Click="OnApplyCustomClick"/>
        </StackPanel>
        <TextBlock x:Name="CustomError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
      </StackPanel>
      <StackPanel Spacing="12">
        <TextBlock x:Name="UpdatesTitle" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
        <ComboBox x:Name="ChannelBox" Header="{x:Bind loc:Strings.SettingsUpdateChannel}" AutomationProperties.Name="{x:Bind loc:Strings.SettingsUpdateChannel}"
                  SelectionChanged="OnChannelChanged">
          <ComboBoxItem Content="{x:Bind loc:Strings.SettingsChannelStable}" Tag="Stable"/>
          <ComboBoxItem Content="{x:Bind loc:Strings.SettingsChannelPreview}" Tag="Preview"/>
        </ComboBox>
        <ToggleSwitch Header="{x:Bind loc:Strings.SettingsCheckAutomatically}" AutomationProperties.Name="{x:Bind loc:Strings.SettingsCheckAutomatically}"
                      OnContent="{x:Bind loc:Strings.CommonOn}" OffContent="{x:Bind loc:Strings.CommonOff}"
                      IsOn="{x:Bind ViewModel.CheckAutomatically, Mode=TwoWay}"/>
        <TextBlock TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Bind loc:Strings.SettingsCheckNow}" Command="{x:Bind ViewModel.CheckNowCommand}"/>
          <Button Content="{x:Bind loc:Strings.UpdateDownload}" Command="{x:Bind ViewModel.DownloadCommand}"
                  Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowDownload), Mode=OneWay}"/>
          <Button Content="{x:Bind loc:Strings.PaletteRestartToUpdate}" Style="{StaticResource AccentButtonStyle}"
                  Command="{x:Bind ViewModel.RestartAndApplyCommand}"
                  Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowRestart), Mode=OneWay}"/>
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" AutomationProperties.Name="{x:Bind loc:Strings.UpdateDownloadProgress}"
                     Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}"
                     Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsDownloading), Mode=OneWay}"/>
        <ScrollViewer MaxHeight="180" AutomationProperties.Name="{x:Bind loc:Strings.UpdateReleaseNotes}"
                      Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.HasNotes), Mode=OneWay}">
          <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                     Text="{x:Bind ViewModel.Notes, Mode=OneWay}"/>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
