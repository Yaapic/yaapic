<UserControl
    xmlns:loc="using:Yaapic.Localization" x:Class="Yaapic.App.WinUI.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.WinUI"
             xmlns:p="using:Yaapic.App.WinUI.Presentation">
  <Grid Height="24" Padding="10,0" Background="{ThemeResource YaapicSurfaceAppBrush}"
        BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,1,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
               Style="{StaticResource YaapicCaptionTextStyle}" Foreground="{ThemeResource YaapicWarningBrush}"
               Text="{x:Bind p:TextMap.FirstLine(ViewModel.ScriptEngineWarnings), Mode=OneWay}"
               ToolTipService.ToolTip="{x:Bind p:TextMap.JoinLines(ViewModel.ScriptEngineWarnings), Mode=OneWay}"
               Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.HasScriptEngineWarnings), Mode=OneWay}"/>
    <!-- The icon shows the layout the button switches to. -->
    <Button x:Name="LayoutToggle" Grid.Column="1" Style="{StaticResource YaapicSubtleButtonStyle}"
            AutomationProperties.AutomationId="Layout" AutomationProperties.Name="{x:Bind loc:Strings.LayoutSwitch}"
            ToolTipService.ToolTip="{x:Bind loc:Strings.LayoutToggleTip}"
            MinHeight="0" Height="22" Padding="8,0" VerticalAlignment="Center"
            Command="{x:Bind ViewModel.Layout.ToggleCommand, Mode=OneWay}">
      <Viewbox Width="14" Height="14" Margin="0,2,0,0">
        <Grid>
          <ic:FluentIcon Icon="SplitVertical" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                         Visibility="{x:Bind p:VisibilityMap.WhenFalse(ViewModel.Layout.IsHorizontal), Mode=OneWay}"/>
          <ic:FluentIcon Icon="SplitHorizontal" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                         Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.Layout.IsHorizontal), Mode=OneWay}"/>
        </Grid>
      </Viewbox>
    </Button>
    <Button x:Name="VaultButton" Grid.Column="2" Style="{StaticResource YaapicSubtleButtonStyle}"
            AutomationProperties.AutomationId="Vault" AutomationProperties.Name="{x:Bind ViewModel.Vault.StatusText, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind p:TextMap.VaultTip(ViewModel.Vault.ProtectorLabel), Mode=OneWay}"
            MinHeight="0" Height="22" Padding="8,0" VerticalAlignment="Center" Click="OnVaultClick">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <FontIcon FontSize="12" VerticalAlignment="Center"
                  Glyph="{x:Bind p:TextMap.VaultGlyph(ViewModel.Vault.IsUnlocked), Mode=OneWay}"
                  Foreground="{x:Bind p:BrushMap.ConsoleToggle(ViewModel.Vault.IsUnlocked), Mode=OneWay}"/>
        <TextBlock Text="{x:Bind ViewModel.Vault.StatusText, Mode=OneWay}" VerticalAlignment="Center"
                   Style="{StaticResource YaapicCaptionTextStyle}"/>
      </StackPanel>
      <FlyoutBase.AttachedFlyout>
        <MenuFlyout x:Name="VaultFlyout">
          <MenuFlyoutItem Text="{x:Bind loc:Strings.VaultLock}" Command="{x:Bind ViewModel.Vault.LockCommand, Mode=OneWay}"/>
        </MenuFlyout>
      </FlyoutBase.AttachedFlyout>
    </Button>
    <Button x:Name="ConsoleToggle" Grid.Column="3" Style="{StaticResource YaapicSubtleButtonStyle}"
            AutomationProperties.AutomationId="Console" AutomationProperties.Name="{x:Bind loc:Strings.ConsoleTitle}"
            ToolTipService.ToolTip="{x:Bind loc:Strings.ConsoleToggleTip}"
            MinHeight="0" Height="22" Padding="8,0" VerticalAlignment="Center"
            Command="{x:Bind ViewModel.ToggleConsoleCommand, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{x:Bind loc:Strings.ConsoleTitle}" VerticalAlignment="Center" Style="{StaticResource YaapicCaptionTextStyle}"
                   Foreground="{x:Bind p:BrushMap.ConsoleToggle(ViewModel.IsConsoleOpen), Mode=OneWay}"/>
        <Border CornerRadius="8" Padding="5,0" Background="{ThemeResource YaapicWarningBackgroundBrush}"
                Visibility="{x:Bind p:VisibilityMap.WhenPositive(ViewModel.Console.WarnCount), Mode=OneWay}">
          <TextBlock Text="{x:Bind ViewModel.Console.WarnCount, Mode=OneWay}" Style="{StaticResource YaapicBadgeTextStyle}"
                     Foreground="{ThemeResource YaapicWarningBrush}" AutomationProperties.Name="{x:Bind loc:Strings.StatusWarnings}"/>
        </Border>
        <Border CornerRadius="8" Padding="5,0" Background="{ThemeResource YaapicDangerBackgroundBrush}"
                Visibility="{x:Bind p:VisibilityMap.WhenPositive(ViewModel.Console.ErrorCount), Mode=OneWay}">
          <TextBlock Text="{x:Bind ViewModel.Console.ErrorCount, Mode=OneWay}" Style="{StaticResource YaapicBadgeTextStyle}"
                     Foreground="{ThemeResource YaapicDangerBrush}" AutomationProperties.Name="{x:Bind loc:Strings.StatusErrors}"/>
        </Border>
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
