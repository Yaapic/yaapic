<UserControl
    xmlns:loc="using:Yaapic.Localization" x:Class="Yaapic.App.WinUI.Views.AuthEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:Yaapic.App.WinUI.Presentation">
  <StackPanel Spacing="12" MaxWidth="480" HorizontalAlignment="Left">
    <ComboBox x:Name="KindBox" Header="{x:Bind loc:Strings.CommonType}" MinWidth="200" AutomationProperties.Name="{x:Bind loc:Strings.AuthType}"
              SelectionChanged="OnKindChanged">
      <ComboBoxItem Content="{x:Bind loc:Strings.BodyNone}"/>
      <ComboBoxItem Content="Basic Auth"/>
      <ComboBoxItem Content="Bearer Token"/>
      <ComboBoxItem Content="API Key"/>
    </ComboBox>

    <TextBlock Text="{x:Bind loc:Strings.AuthNone}" Style="{StaticResource YaapicBodySmallTextStyle}"
               Visibility="{x:Bind p:VisibilityMap.WhenNoAuth(ViewModel.Kind), Mode=OneWay}"/>

    <StackPanel Spacing="12" Visibility="{x:Bind p:VisibilityMap.WhenBasicAuth(ViewModel.Kind), Mode=OneWay}">
      <TextBox Header="{x:Bind loc:Strings.AuthUsername}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
               BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
               Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <PasswordBox Header="{x:Bind loc:Strings.AuthPassword}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
                   Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>
    </StackPanel>

    <PasswordBox Header="{x:Bind loc:Strings.AuthToken}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
                 Password="{x:Bind ViewModel.Token, Mode=TwoWay}"
                 Visibility="{x:Bind p:VisibilityMap.WhenBearerAuth(ViewModel.Kind), Mode=OneWay}"/>

    <StackPanel Spacing="12" Visibility="{x:Bind p:VisibilityMap.WhenApiKeyAuth(ViewModel.Kind), Mode=OneWay}">
      <TextBox Header="{x:Bind loc:Strings.EditorKey}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
               BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
               Text="{x:Bind ViewModel.Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBox Header="{x:Bind loc:Strings.EditorValue}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
               BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
               Text="{x:Bind ViewModel.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <ComboBox x:Name="LocationBox" Header="{x:Bind loc:Strings.AuthAddTo}" MinWidth="200" SelectionChanged="OnLocationChanged">
        <ComboBoxItem Content="{x:Bind loc:Strings.AuthLocationHeader}"/>
        <ComboBoxItem Content="{x:Bind loc:Strings.AuthLocationQuery}"/>
      </ComboBox>
    </StackPanel>
  </StackPanel>
</UserControl>
