<UserControl
    x:Class="Yaapic.App.WinUI.Views.OAuth2EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Yaapic.Localization"
    xmlns:p="using:Yaapic.App.WinUI.Presentation">
  <StackPanel Spacing="12">
    <ComboBox x:Name="GrantBox" Header="{x:Bind loc:Strings.Oauth2FieldGrant}" MinWidth="200" SelectionChanged="OnGrantChanged">
      <ComboBoxItem Content="{x:Bind loc:Strings.Oauth2GrantClientCredentials}"/>
      <ComboBoxItem Content="{x:Bind loc:Strings.Oauth2GrantAuthorizationCode}"/>
      <ComboBoxItem Content="{x:Bind loc:Strings.Oauth2GrantPassword}"/>
    </ComboBox>

    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldTokenUrl}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.TokenUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldAuthorizationUrl}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.AuthorizationUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowAuthorizationUrl), Mode=OneWay}"/>
    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldRedirectUri}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.RedirectUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowRedirectUri), Mode=OneWay}"/>
    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldClientId}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <PasswordBox BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}" Header="{x:Bind loc:Strings.Oauth2FieldClientSecret}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
                 Password="{x:Bind ViewModel.ClientSecret, Mode=TwoWay}"/>
    <StackPanel Spacing="12" Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowUserCredentials), Mode=OneWay}">
      <TextBox Header="{x:Bind loc:Strings.Oauth2FieldUsername}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
               BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
               Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <PasswordBox BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}" Header="{x:Bind loc:Strings.Oauth2FieldPassword}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
                   Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>
    </StackPanel>
    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldScope}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldAudience}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.Audience, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <ComboBox x:Name="ClientAuthBox" Header="{x:Bind loc:Strings.Oauth2FieldClientAuthentication}" MinWidth="200"
              SelectionChanged="OnClientAuthChanged">
      <ComboBoxItem Content="{x:Bind loc:Strings.Oauth2ClientAuthBasic}"/>
      <ComboBoxItem Content="{x:Bind loc:Strings.Oauth2ClientAuthBody}"/>
    </ComboBox>
    <ComboBox x:Name="PlacementBox" Header="{x:Bind loc:Strings.Oauth2FieldPlacement}" MinWidth="200" SelectionChanged="OnPlacementChanged">
      <ComboBoxItem Content="{x:Bind loc:Strings.AuthLocationHeader}"/>
      <ComboBoxItem Content="{x:Bind loc:Strings.AuthLocationQuery}"/>
    </ComboBox>
    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldHeaderPrefix}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.HeaderPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowHeaderPrefix), Mode=OneWay}"/>
    <TextBox Header="{x:Bind loc:Strings.Oauth2FieldQueryParameterName}" PlaceholderText="{x:Bind loc:Strings.EditingVariableHint}"
             BorderThickness="1" BorderBrush="{ThemeResource YaapicBorderDefaultBrush}"
             Text="{x:Bind ViewModel.QueryParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowQueryParameterName), Mode=OneWay}"/>

    <ItemsControl ItemsSource="{x:Bind ViewModel.Hints, Mode=OneWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Message="{x:Bind}" Margin="0,0,0,8"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Spacing="8">
      <TextBlock Text="{x:Bind ViewModel.TokenStatusText, Mode=OneWay}" Style="{StaticResource YaapicBodySmallTextStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{x:Bind loc:Strings.Oauth2GetNewToken}" Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.GetNewTokenCommand}"/>
        <Button Content="{x:Bind loc:Strings.CommonCancel}" Command="{x:Bind ViewModel.CancelGetTokenCommand}"
                Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsGettingToken), Mode=OneWay}"/>
        <Button Content="{x:Bind loc:Strings.Oauth2ClearToken}" Command="{x:Bind ViewModel.ClearTokenCommand}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8"
                  Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsGettingToken), Mode=OneWay}">
        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsGettingToken, Mode=OneWay}"
                      Style="{StaticResource YaapicProgressRingStyle}"/>
        <TextBlock Text="{x:Bind loc:Strings.Oauth2WaitingForBrowser}" Style="{StaticResource YaapicBodySmallTextStyle}"/>
      </StackPanel>
      <TextBlock Text="{x:Bind ViewModel.TokenError, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource YaapicDangerBrush}"
                 Style="{StaticResource YaapicBodySmallTextStyle}"
                 Visibility="{x:Bind p:VisibilityMap.WhenText(ViewModel.TokenError), Mode=OneWay}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
