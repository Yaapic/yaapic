<ContentDialog x:Class="Yaapic.App.WinUI.Views.FolderSettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:p="using:Yaapic.App.WinUI.Presentation"
               xmlns:v="using:Yaapic.App.WinUI.Views"
               PrimaryButtonText="Save" PrimaryButtonStyle="{StaticResource AccentButtonStyle}" PrimaryButtonClick="OnPrimaryButtonClick"
               CloseButtonText="Close" DefaultButton="None" CloseButtonStyle="{StaticResource YaapicDialogButtonStyle}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
    <Thickness x:Key="ContentDialogPadding">0</Thickness>
    <Thickness x:Key="ContentDialogCommandSpaceMargin">0</Thickness>
  </ContentDialog.Resources>
  <Grid x:Name="Body" Width="640" Background="{ThemeResource YaapicSurfaceBaseBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Padding="20,0" BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"/>
    </Grid>
    <ScrollViewer x:Name="Scroller" Grid.Row="1">
    <StackPanel Margin="20,16,20,16" Spacing="12">
      <InfoBar Severity="Error" IsClosable="False"
               IsOpen="{x:Bind p:VisibilityMap.HasText(ViewModel.LastError), Mode=OneWay}"
               Message="{x:Bind ViewModel.LastError, Mode=OneWay}"/>
      <TextBox Header="Name" AutomationProperties.Name="Name"
               Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBox Header="Description" AutomationProperties.Name="Description" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="88" MaxHeight="160" PlaceholderText="What is this collection for?"
               Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <StackPanel Spacing="8" Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowVariables)}">
        <TextBlock Text="Collection variables" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
        <TextBlock Style="{StaticResource YaapicBodySmallTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                   Text="Override globals; the active environment overrides them."/>
        <v:KeyValueEditorView x:Name="Variables" KeyHeader="Variable" Height="220" MinHeight="120"/>
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</ContentDialog>
