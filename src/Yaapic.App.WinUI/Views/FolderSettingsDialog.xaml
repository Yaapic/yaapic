<ContentDialog
    xmlns:loc="using:Yaapic.Localization" x:Class="Yaapic.App.WinUI.Views.FolderSettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:p="using:Yaapic.App.WinUI.Presentation"
               xmlns:v="using:Yaapic.App.WinUI.Views"
               PrimaryButtonText="{x:Bind loc:Strings.CommonSave}" PrimaryButtonStyle="{StaticResource AccentButtonStyle}" PrimaryButtonClick="OnPrimaryButtonClick"
               CloseButtonText="{x:Bind loc:Strings.CommonClose}" DefaultButton="None" CloseButtonStyle="{StaticResource YaapicDialogButtonStyle}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
    <Thickness x:Key="ContentDialogPadding">0</Thickness>
    <Thickness x:Key="ContentDialogCommandSpaceMargin">0</Thickness>
  </ContentDialog.Resources>
  <Grid x:Name="Body" Width="640" Background="{ThemeResource YaapicSurfaceBaseBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Padding="20,0" BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="{x:Bind loc:Strings.SettingsTitle}" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"/>
    </Grid>
    <ScrollViewer x:Name="Scroller" Grid.Row="1">
    <StackPanel Margin="20,16,20,16" Spacing="12">
      <InfoBar Severity="Error" IsClosable="False"
               IsOpen="{x:Bind p:VisibilityMap.HasText(ViewModel.LastError), Mode=OneWay}"
               Message="{x:Bind ViewModel.LastError, Mode=OneWay}"/>
      <TextBox Header="{x:Bind loc:Strings.CommonName}" AutomationProperties.Name="{x:Bind loc:Strings.CommonName}"
               Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBox Header="{x:Bind loc:Strings.CommonDescription}" AutomationProperties.Name="{x:Bind loc:Strings.CommonDescription}" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="88" MaxHeight="160" PlaceholderText="{x:Bind loc:Strings.CollectionsDescriptionPlaceholder}"
               Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <StackPanel Spacing="8" Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowVariables)}">
        <TextBlock Text="{x:Bind loc:Strings.CollectionsVariables}" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
        <TextBlock Style="{StaticResource YaapicBodySmallTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                   Text="{x:Bind loc:Strings.CollectionsVariablesHint}"/>
        <v:KeyValueEditorView x:Name="Variables" KeyHeader="{x:Bind loc:Strings.EditorVariableUpper}" Height="220" MinHeight="120"/>
      </StackPanel>
      <StackPanel Spacing="8" Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.ShowScripts)}">
        <TextBlock Text="{x:Bind loc:Strings.RequestTabScripts}" Style="{StaticResource YaapicBodyStrongTextStyle}"/>
        <TextBlock x:Name="ScriptsHint" Style="{StaticResource YaapicBodySmallTextStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource YaapicTextSecondaryBrush}" Text="{x:Bind ViewModel.ScriptsHint}"/>
        <Border Height="280" MinHeight="240" BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="1">
          <v:ScriptsEditorView x:Name="ScriptsEditor" HintText=""/>
        </Border>
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</ContentDialog>
