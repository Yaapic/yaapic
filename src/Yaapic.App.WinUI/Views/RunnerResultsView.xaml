<UserControl
    x:Class="Yaapic.App.WinUI.Views.RunnerResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Yaapic.Localization"
    xmlns:p="using:Yaapic.App.WinUI.Presentation"
    xmlns:r="using:Yaapic.ViewModels.Runner"
    xmlns:rt="using:Yaapic.ViewModels.Responses">
  <Grid Padding="12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Progress while running, status when done -->
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ProgressBar VerticalAlignment="Center" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                   AutomationProperties.Name="{x:Bind loc:Strings.RunnerResults}"
                   Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsRunning), Mode=OneWay}"/>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                 Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"/>
      <TextBlock AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Style="{StaticResource YaapicBodyStrongTextStyle}"
                 Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 Visibility="{x:Bind p:VisibilityMap.WhenFalse(ViewModel.IsRunning), Mode=OneWay}"/>
    </Grid>

    <!-- Summary tiles -->
    <ItemsControl Grid.Row="1" Visibility="{x:Bind p:VisibilityMap.WhenNotNull(ViewModel.Result), Mode=OneWay}"
                  ItemsSource="{x:Bind p:ListMap.RunnerTiles(ViewModel.SummarySent, ViewModel.SummaryErrors, ViewModel.SummaryFailed, ViewModel.SummarySkipped, ViewModel.SummaryTests, ViewModel.SummaryAverage, ViewModel.SummaryDuration), Mode=OneWay}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsWrapGrid Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="p:SummaryTile">
          <Border Margin="0,0,6,6" Padding="10,4" MinWidth="72" CornerRadius="6" Background="{ThemeResource YaapicSurfaceSunkenBrush}">
            <StackPanel>
              <TextBlock Style="{StaticResource YaapicSubtitleTextStyle}" Text="{x:Bind Value}"/>
              <TextBlock Style="{StaticResource YaapicCaptionTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                         Text="{x:Bind Label}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Filter and export -->
    <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ListView x:Name="FilterChips" Grid.ColumnSpan="2" HorizontalAlignment="Left" Style="{StaticResource YaapicSegmentedStyle}" VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind loc:Strings.RunnerResults}" SelectionChanged="OnFilterChanged">
        <ListViewItem Content="{x:Bind loc:Strings.RunnerFilterAll}"/>
        <ListViewItem Content="{x:Bind loc:Strings.RunnerFilterPassed}"/>
        <ListViewItem Content="{x:Bind loc:Strings.RunnerFilterFailed}"/>
        <ListViewItem Content="{x:Bind loc:Strings.RunnerFilterSkipped}"/>
      </ListView>
      <TextBlock Grid.Row="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource YaapicTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"
                 Text="{x:Bind ViewModel.ExportMessage, Mode=OneWay}"/>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="{x:Bind loc:Strings.RunnerExportJson}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerExportJson}"
                Command="{x:Bind ViewModel.ExportJsonCommand}"/>
        <Button Content="{x:Bind loc:Strings.RunnerExportJUnit}" AutomationProperties.Name="{x:Bind loc:Strings.RunnerExportJUnit}"
                Command="{x:Bind ViewModel.ExportJUnitCommand}"/>
      </StackPanel>
    </Grid>

    <!-- Rows and details: stacked, side by side from 1300 px -->
    <Grid Grid.Row="3" RowSpacing="8" ColumnSpacing="8">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="Narrow"/>
          <VisualState x:Name="Wide">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1300"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="Details.(Grid.Row)" Value="0"/>
              <Setter Target="Details.(Grid.Column)" Value="1"/>
              <Setter Target="RowsList.(Grid.RowSpan)" Value="2"/>
              <Setter Target="Details.MaxHeight" Value="Infinity"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <ListView x:Name="RowsList" SelectionMode="Single" AutomationProperties.Name="{x:Bind loc:Strings.RunnerResults}"
                ItemsSource="{x:Bind p:ListMap.RunnerRows(ViewModel.VisibleRows), Mode=OneWay}"
                SelectionChanged="OnRowSelected">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="r:RunnerResultRowViewModel">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Style="{StaticResource YaapicCaptionTextStyle}"
                         Foreground="{ThemeResource YaapicTextSecondaryBrush}" Text="{x:Bind IterationText}"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource YaapicCaptionTextStyle}" FontWeight="SemiBold"
                         Foreground="{x:Bind p:BrushMap.RunOutcome(Outcome)}" Text="{x:Bind OutcomeText}"/>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource YaapicCaptionTextStyle}" FontWeight="SemiBold"
                         p:MethodBrush.Method="{x:Bind Method}" Text="{x:Bind Method}"/>
              <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource YaapicCaptionTextStyle}" Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{x:Bind Path}"/>
              </StackPanel>
              <!-- Two lines (status and tests, then duration and size) so the name keeps room in a narrow pane -->
              <Grid Grid.Column="4" VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource YaapicCodeSmallTextStyle}" Text="{x:Bind StatusText}"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YaapicCodeSmallTextStyle}" Text="{x:Bind TestsText}"/>
                <TextBlock Grid.Row="1" Style="{StaticResource YaapicCodeSmallTextStyle}"
                           Foreground="{ThemeResource YaapicTextSecondaryBrush}" Text="{x:Bind DurationText}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YaapicCodeSmallTextStyle}"
                           Foreground="{ThemeResource YaapicTextSecondaryBrush}" Text="{x:Bind SizeText}"/>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <ScrollViewer x:Name="Details" Grid.Row="1" MinWidth="320" MaxWidth="560" MaxHeight="220"
                    Visibility="{x:Bind p:VisibilityMap.WhenNotNull(ViewModel.SelectedRow), Mode=OneWay}">
        <StackPanel Spacing="8">
          <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource YaapicCodeSmallTextStyle}"
                     Foreground="{ThemeResource YaapicDangerBrush}" Text="{x:Bind ViewModel.SelectedError, Mode=OneWay}"
                     Visibility="{x:Bind p:VisibilityMap.WhenText(ViewModel.SelectedError), Mode=OneWay}"/>
          <ItemsControl ItemsSource="{x:Bind p:ListMap.RunnerTests(ViewModel.SelectedTests), Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rt:TestResultItemViewModel">
                <Grid ColumnSpacing="8" RowSpacing="2" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{x:Bind Symbol}" AutomationProperties.Name="{x:Bind StatusText}"
                             Style="{StaticResource YaapicBodyStrongTextStyle}" Foreground="{x:Bind p:BrushMap.TestOutcome(Passed)}"/>
                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Message}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                             Style="{StaticResource YaapicCodeSmallTextStyle}" Foreground="{ThemeResource YaapicDangerBrush}"
                             Visibility="{x:Bind p:VisibilityMap.WhenText(Message)}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource YaapicBodyStrongTextStyle}" Text="{x:Bind loc:Strings.ConsoleTitle}"
                     Visibility="{x:Bind p:VisibilityMap.WhenPositive(ViewModel.SelectedConsole.Count), Mode=OneWay}"/>
          <ItemsControl ItemsSource="{x:Bind p:ListMap.Lines(ViewModel.SelectedConsole), Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource YaapicCodeSmallTextStyle}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
