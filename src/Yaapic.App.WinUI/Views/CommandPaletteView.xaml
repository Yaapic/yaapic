<UserControl x:Class="Yaapic.App.WinUI.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Yaapic.App.WinUI.Presentation"
             xmlns:pal="using:Yaapic.ViewModels.Palette"
             Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsOpen), Mode=OneWay}">
  <Grid x:Name="Overlay" SizeChanged="OnOverlaySizeChanged">
    <Border x:Name="Scrim" Background="#66000000" Tapped="OnScrimTapped"/>
    <!-- Never shown: only supplies the themed accent brush used for matched title characters. -->
    <TextBlock x:Name="AccentProbe" Visibility="Collapsed" Foreground="{ThemeResource YaapicAccentTextBrush}"/>
    <Border x:Name="Card" Width="560" MaxHeight="440" VerticalAlignment="Top" HorizontalAlignment="Center"
            Background="{ThemeResource YaapicSurfaceOverlayBrush}"
            BorderBrush="{ThemeResource YaapicBorderOverlayBrush}" BorderThickness="1"
            CornerRadius="{StaticResource YaapicRadiusLg}" PreviewKeyDown="OnCardKeyDown">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="QueryBox" MinHeight="44" Padding="16,11" BorderThickness="0" Background="Transparent" IsSpellCheckEnabled="False"
                 PlaceholderText="Type a command or search requests" AutomationProperties.Name="Command palette"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Border Grid.Row="1" BorderBrush="{ThemeResource YaapicBorderSubtleBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <ListView x:Name="ResultList" IsItemClickEnabled="True" SelectionMode="Single" Padding="6"
                      ItemClick="OnResultClick" ContainerContentChanging="OnContainerContentChanging"
                      ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="pal:PaletteResult">
                  <Grid ColumnSpacing="10" Padding="4,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource YaapicBodyTextStyle}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{x:Bind Item.Subtitle}" TextTrimming="CharacterEllipsis"
                                 Style="{StaticResource YaapicBodySmallTextStyle}"
                                 Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                                 Visibility="{x:Bind p:VisibilityMap.WhenText(Item.Subtitle)}"/>
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource YaapicChipBorderStyle}"
                            Background="{ThemeResource YaapicSurfaceSunkenBrush}">
                      <TextBlock Text="{x:Bind Item.Category}" Style="{StaticResource YaapicChipTextStyle}"
                                 Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
                    </Border>
                    <Border Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource YaapicKeycapBorderStyle}"
                            Visibility="{x:Bind p:VisibilityMap.WhenText(Item.Shortcut)}">
                      <TextBlock Text="{x:Bind Item.Shortcut}" Style="{StaticResource YaapicCodeSmallTextStyle}"
                                 Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="No matching commands" HorizontalAlignment="Center" Margin="16,20"
                       Style="{StaticResource YaapicBodySmallTextStyle}"
                       Foreground="{ThemeResource YaapicTextSecondaryBrush}"
                       Visibility="{x:Bind p:VisibilityMap.WhenTrue(ViewModel.IsEmpty), Mode=OneWay}"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
