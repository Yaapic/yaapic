<UserControl x:Class="Yaapic.App.WinUI.Views.VariablePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyDown="OnKeyDown">
  <UserControl.Resources>
    <!-- The hosting editor flattens every TextBox (and the URL box hides its text); the popup fields keep their frame. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource YaapicSurfaceSunkenColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource YaapicSurfaceSunkenColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource YaapicSurfaceSunkenColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource YaapicBorderControlColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource YaapicBorderControlColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource YaapicFocusRingColor}"/>
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{ThemeResource YaapicBorderControlColor}"/>
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  </UserControl.Resources>
  <Border Background="{ThemeResource YaapicSurfaceElevatedBrush}"
          BorderBrush="{ThemeResource YaapicBorderOverlayBrush}" BorderThickness="1"
          CornerRadius="{StaticResource YaapicRadiusMd}" Padding="12" MinWidth="280" MaxWidth="380">
    <StackPanel Spacing="8">
      <!-- Resolved and dynamic: the name in the token colour and the scope badge. -->
      <Grid ColumnSpacing="8" Visibility="{x:Bind IsKnown, Mode=OneTime}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="NameResolved" Text="{x:Bind ViewModel.Name}" FontFamily="{StaticResource YaapicMonoFont}"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Foreground="{ThemeResource YaapicSuccessBrush}" Visibility="{x:Bind IsResolvedState, Mode=OneTime}"/>
        <TextBlock x:Name="NameDynamic" Text="{x:Bind ViewModel.Name}" FontFamily="{StaticResource YaapicMonoFont}"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Foreground="{ThemeResource YaapicInfoBrush}" Visibility="{x:Bind IsDynamicState, Mode=OneTime}"/>
        <Border Grid.Column="1" Style="{StaticResource YaapicChipBorderStyle}" Background="{ThemeResource YaapicSurfaceRaisedBrush}"
                AutomationProperties.Name="{x:Bind ViewModel.ScopeLabel}">
          <TextBlock Style="{StaticResource YaapicChipTextStyle}" Text="{x:Bind ViewModel.ScopeLabel}"
                     Foreground="{ThemeResource YaapicTextSecondaryBrush}"/>
        </Border>
      </Grid>

      <!-- Unresolved: icon and title. -->
      <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsUnresolvedState, Mode=OneTime}">
        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
          <Canvas Width="24" Height="24">
            <Path Data="M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"
                  Stroke="{ThemeResource YaapicDangerBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>
        </Viewbox>
        <TextBlock Text="{x:Bind ViewModel.Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{ThemeResource YaapicTextPrimaryBrush}"/>
      </StackPanel>

      <TextBlock Text="{x:Bind ViewModel.Message}" TextWrapping="Wrap" Style="{StaticResource YaapicBodyTextStyle}"
                 Foreground="{ThemeResource YaapicTextSecondaryBrush}" Visibility="{x:Bind HasMessage, Mode=OneTime}"/>

      <!-- Resolved: value, Edit, Open. -->
      <StackPanel Spacing="8" Visibility="{x:Bind IsResolvedState, Mode=OneTime}">
        <TextBlock x:Name="ValueText" Text="{x:Bind ViewModel.Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                   FontFamily="{StaticResource YaapicMonoFont}" FontSize="{StaticResource YaapicFontSizeBody}"
                   Foreground="{ThemeResource YaapicTextPrimaryBrush}"
                   Visibility="{x:Bind ShowValue(ViewModel.IsEditing), Mode=OneWay}"/>
        <Grid ColumnSpacing="8" Visibility="{x:Bind ShowEditor(ViewModel.IsEditing), Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="EditBox" MinHeight="0" Padding="8,5" AutomationProperties.Name="Value"
                   FontFamily="{StaticResource YaapicMonoFont}" FontSize="{StaticResource YaapicFontSizeBody}"
                   Text="{x:Bind ViewModel.EditableValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="OnValueKeyDown"/>
          <Button Grid.Column="1" Content="Save" Style="{StaticResource YaapicPrimaryButtonStyle}" AutomationProperties.Name="Save"
                  Command="{x:Bind ViewModel.SubmitCommand, Mode=OneWay}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <HyperlinkButton x:Name="EditLink" Content="Edit" Padding="4,2" AutomationProperties.Name="Edit"
                           Command="{x:Bind ViewModel.ToggleEditCommand}"/>
          <HyperlinkButton Content="Open" Padding="4,2" AutomationProperties.Name="Open"
                           Command="{x:Bind ViewModel.OpenCommand}"/>
        </StackPanel>
      </StackPanel>

      <!-- Unresolved: where to create it and with which value. -->
      <StackPanel Spacing="8" Visibility="{x:Bind IsUnresolvedState, Mode=OneTime}">
        <ComboBox x:Name="ScopeBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Scope"
                  SelectionChanged="OnScopeChanged"/>
        <TextBox x:Name="CreateBox" PlaceholderText="Value" MinHeight="0" Padding="8,5" AutomationProperties.Name="Value"
                 FontFamily="{StaticResource YaapicMonoFont}" FontSize="{StaticResource YaapicFontSizeBody}"
                 Text="{x:Bind ViewModel.EditableValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnValueKeyDown"/>
        <Button Content="Create" Style="{StaticResource YaapicPrimaryButtonStyle}" AutomationProperties.Name="Create"
                HorizontalAlignment="Right" Command="{x:Bind ViewModel.SubmitCommand, Mode=OneWay}"/>
      </StackPanel>

      <TextBlock Text="{x:Bind ViewModel.LastError, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource YaapicBodyTextStyle}"
                 Foreground="{ThemeResource YaapicDangerBrush}" Visibility="{x:Bind ShowError(ViewModel.LastError), Mode=OneWay}"/>
    </StackPanel>
  </Border>
</UserControl>
