<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Yaapic.App.Avalonia</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\design\app-icons\windows\yaapic.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- .NET 11 publishes AOT without a full build, so the documentation file is never produced. -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="LoomEditor.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yaapic.Composition\Yaapic.Composition.csproj" />
    <ProjectReference Include="..\Yaapic.UI.Abstractions\Yaapic.UI.Abstractions.csproj" />
    <ProjectReference Include="..\Yaapic.ViewModels\Yaapic.ViewModels.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated resources live in design/; link them so Avalonia compiles them into the assembly. -->
    <AvaloniaResource Include="..\..\design\xaml\Yaapic.Colors.Avalonia.axaml" Link="Themes\Yaapic.Colors.Avalonia.axaml" />
    <AvaloniaResource Include="..\..\design\xaml\Yaapic.Icons.Avalonia.axaml" Link="Themes\Yaapic.Icons.Avalonia.axaml" />
    <AvaloniaResource Include="..\Yaapic.App.WinUI\Assets\Fonts\JetBrainsMono.ttf" Link="Assets\Fonts\JetBrainsMono.ttf" />
  </ItemGroup>
</Project>

