<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yaapic.App.Avalonia.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Yaapic.App.Avalonia/Styles/Yaapic.Typography.axaml" />
    <StyleInclude Source="avares://Yaapic.App.Avalonia/Styles/Yaapic.Controls.axaml" />
    <StyleInclude Source="avares://Yaapic.App.Avalonia/Styles/Yaapic.Navigation.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Yaapic.App.Avalonia/Themes/Yaapic.Colors.Avalonia.axaml" />
        <ResourceInclude Source="avares://Yaapic.App.Avalonia/Themes/Yaapic.Icons.Avalonia.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="YaapicUiFont">Segoe UI Variable Text, Inter, Segoe UI, SF Pro Text, system-ui</FontFamily>
      <!-- Fluent controls read these two keys for their own text. -->
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Inter, Segoe UI, SF Pro Text, system-ui</FontFamily>
      <StaticResource x:Key="ControlContentThemeFontSize" ResourceKey="YaapicFontSizeBody" />
      <!-- Overrides the generated key, whose avares:// authority is not this assembly. -->
      <FontFamily x:Key="YaapicMonoFont">avares://Yaapic.App.Avalonia/Assets/Fonts#JetBrains Mono</FontFamily>
      <!-- Fluent reads these for text box borders and rounded corners; focus = 1 px ring colour plus a 2 px bottom border. -->
      <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,2</Thickness>
      <StaticResource x:Key="ControlCornerRadius" ResourceKey="YaapicRadiusControl" />
      <StaticResource x:Key="OverlayCornerRadius" ResourceKey="YaapicRadiusOverlay" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
