<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Avalonia.Controls.Primitives">
  <!-- Navigation, feedback and dialog styles of M1-50 (design/mockups/DSComposants2.dc.html). Metrics and templates only:
       colours come from the generated keys. Most have no screen yet; M1-51 onward applies the classes. -->

  <!-- List rows: every ListBox. The accent bar is the 2 px inset at the left edge of the selected row. -->
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,0,10,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Grid>
            <!-- Not named PART_ContentPresenter on purpose: Fluent's selected style paints that name in the system accent. -->
            <ContentPresenter x:Name="ItemContent" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border x:Name="SelectionBar" Width="2" HorizontalAlignment="Left" IsVisible="False"
                    Background="{DynamicResource YaapicAccentFillBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource YaapicOverlayHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pressed /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource YaapicOverlayPressedBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource YaapicSelectionBackgroundBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ Border#SelectionBar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBoxItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextDisabledBrush}" />
  </Style>
  <Style Selector="ListBoxItem.roomy">
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <!-- Panel tabs: underline on the selected tab, a subtle line under the strip. -->
  <Style Selector="TabControl.panel">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <Border BorderBrush="{DynamicResource YaapicBorderSubtleBrush}" BorderThickness="0,0,0,1">
            <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="18" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.panel > TabItem">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource YaapicFontSizeBodySm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root" Background="{TemplateBinding Background}">
          <Grid>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}" Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="Center" />
            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" IsVisible="False"
                    Background="{DynamicResource YaapicAccentFillBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.panel > TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextPrimaryBrush}" />
  </Style>
  <Style Selector="TabControl.panel > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextPrimaryBrush}" />
  </Style>
  <Style Selector="TabControl.panel > TabItem:selected /template/ Border#Underline">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TabItem:selected TextBlock.badge">
    <Setter Property="Foreground" Value="{DynamicResource YaapicAccentTextBrush}" />
  </Style>

  <!-- Request tabs: square tabs on the sidebar surface, the selected one on the base surface with an accent top line. -->
  <Style Selector="TabControl.requests">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <Border Height="36" Background="{DynamicResource YaapicSurfaceSidebarBrush}"
                  BorderBrush="{DynamicResource YaapicBorderSubtleBrush}" BorderThickness="0,0,0,1">
            <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.requests > TabItem">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MaxWidth" Value="210" />
    <Setter Property="Padding" Value="12,0,10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextSecondaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root" Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource YaapicBorderSubtleBrush}" BorderThickness="0,0,1,0">
          <Grid>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}" Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="Center" />
            <Border x:Name="TopLine" Height="2" VerticalAlignment="Top" Margin="0,2,0,0"
                    Background="{DynamicResource YaapicAccentFillBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.requests > TabItem:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource YaapicOverlayHoverBrush}" />
  </Style>
  <Style Selector="TabControl.requests > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextPrimaryBrush}" />
  </Style>
  <Style Selector="TabControl.requests > TabItem:selected /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource YaapicSurfaceBaseBrush}" />
  </Style>
  <Style Selector="TabControl.requests > TabItem /template/ Border#TopLine">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TabControl.requests > TabItem:selected /template/ Border#TopLine">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Segmented control: a horizontal ListBox; the selected item is a raised chip inside a sunken track. -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource YaapicSurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicBorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource YaapicSurfaceElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicBorderDefaultBrush}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ Border#SelectionBar">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Chip, keycap, skeleton. The chip colours come from ResponseMap.StatusBackground / StatusForeground. -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,1" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource YaapicMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource YaapicFontSizeCode}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.keycap">
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicBorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.skeleton">
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource YaapicSurfaceRaisedBrush}" />
  </Style>

  <!-- Environment pill: 8 px Ellipse + name + chevron icon. -->
  <Style Selector="Button.pill">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource YaapicRadiusFull}" />
  </Style>
  <Style Selector="Button.pill /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicBorderDefaultBrush}" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource YaapicOverlayHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicBorderDefaultBrush}" />
  </Style>

  <!-- Progress: a 2 px line. -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="2" />
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource YaapicAccentFillBrush}" />
    <Setter Property="Background" Value="{DynamicResource YaapicBorderSubtleBrush}" />
  </Style>

  <!-- Info bars. -->
  <Style Selector="Border.infobar">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.infobar.info">
    <Setter Property="Background" Value="{DynamicResource YaapicInfoBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicInfoBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource YaapicInfoBrush}" />
  </Style>
  <Style Selector="Border.infobar.success">
    <Setter Property="Background" Value="{DynamicResource YaapicSuccessBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicSuccessBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource YaapicSuccessBrush}" />
  </Style>
  <Style Selector="Border.infobar.warning">
    <Setter Property="Background" Value="{DynamicResource YaapicWarningBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicWarningBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource YaapicWarningBrush}" />
  </Style>
  <Style Selector="Border.infobar.danger">
    <Setter Property="Background" Value="{DynamicResource YaapicDangerBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicDangerBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource YaapicDangerBrush}" />
  </Style>

  <!-- Dialog windows: overlay body, raised command area with equal-width buttons. -->
  <Style Selector="Window.dialog">
    <Setter Property="Background" Value="{DynamicResource YaapicSurfaceOverlayBrush}" />
    <Setter Property="MinWidth" Value="400" />
    <Setter Property="CanResize" Value="False" />
    <Setter Property="ShowInTaskbar" Value="False" />
    <Setter Property="WindowStartupLocation" Value="CenterOwner" />
    <Setter Property="SizeToContent" Value="WidthAndHeight" />
  </Style>
  <Style Selector="Window.dialog TextBlock.dialogBody">
    <Setter Property="Foreground" Value="{DynamicResource YaapicTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.dialogCommands">
    <Setter Property="Background" Value="{DynamicResource YaapicSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource YaapicBorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,14" />
  </Style>
  <Style Selector="Border.dialogCommands p|UniformGrid">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.dialogCommands Button">
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
</Styles>
