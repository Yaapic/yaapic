<UserControl
    xmlns:loc="using:Yaapic.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yaapic.ViewModels.Shell"
             xmlns:p="using:Yaapic.App.Avalonia.Presentation"
             x:Class="Yaapic.App.Avalonia.Views.StatusBarView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="YiLayoutStacked">M4 5h16v14H4zM4 12h16</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.consoleToggle">
      <Setter Property="Foreground" Value="{DynamicResource YaapicTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.consoleToggle.open">
      <Setter Property="Foreground" Value="{DynamicResource YaapicAccentTextBrush}" />
    </Style>
    <Style Selector="PathIcon.vaultIcon">
      <Setter Property="Foreground" Value="{DynamicResource YaapicTextSecondaryBrush}" />
    </Style>
    <Style Selector="PathIcon.vaultIcon.unlocked">
      <Setter Property="Foreground" Value="{DynamicResource YaapicAccentTextBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Height="24" Padding="10,0" Background="{DynamicResource YaapicSurfaceAppBrush}"
          BorderThickness="0,1,0,0" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource YaapicWarningBrush}"
                 Text="{Binding ScriptEngineWarnings, Converter={x:Static p:ConsoleMap.FirstLine}}"
                 ToolTip.Tip="{Binding ScriptEngineWarnings, Converter={x:Static p:ConsoleMap.JoinLines}}"
                 IsVisible="{Binding HasScriptEngineWarnings}" />
      <!-- The icon shows the layout the button switches to. -->
      <Button x:Name="LayoutToggle" Grid.Column="1" Classes="subtle" MinHeight="0" Height="22" Padding="8,0"
              VerticalAlignment="Center" Command="{Binding Layout.ToggleCommand}"
              AutomationProperties.AutomationId="Layout" AutomationProperties.Name="{x:Static loc:Strings.LayoutSwitch}"
              ToolTip.Tip="{x:Static loc:Strings.LayoutToggleTip}">
        <Panel>
          <Path Data="{StaticResource YiSplit}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.5"
                Stroke="{DynamicResource YaapicTextSecondaryBrush}" IsVisible="{Binding !Layout.IsHorizontal}" />
          <Path Data="{StaticResource YiLayoutStacked}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.5"
                Stroke="{DynamicResource YaapicTextSecondaryBrush}" IsVisible="{Binding Layout.IsHorizontal}" />
        </Panel>
      </Button>
      <Button x:Name="VaultButton" Grid.Column="2" Classes="subtle" MinHeight="0" Height="22" Padding="8,0"
              VerticalAlignment="Center" Click="OnVaultClick"
              AutomationProperties.AutomationId="Vault" AutomationProperties.Name="{Binding Vault.StatusText}"
              ToolTip.Tip="{Binding Vault.ProtectorLabel, Converter={x:Static p:VaultMap.Tip}}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource YiSecret}" Width="12" Height="12" VerticalAlignment="Center"
                    Classes="vaultIcon" Classes.unlocked="{Binding Vault.IsUnlocked}" />
          <TextBlock Text="{Binding Vault.StatusText}" Classes="caption" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="ConsoleToggle" Grid.Column="3" Classes="subtle" MinHeight="0" Height="22" Padding="8,0"
              VerticalAlignment="Center" Command="{Binding ToggleConsoleCommand}"
              AutomationProperties.AutomationId="Console" AutomationProperties.Name="{x:Static loc:Strings.ConsoleTitle}"
              ToolTip.Tip="{x:Static loc:Strings.ConsoleToggleTip}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{x:Static loc:Strings.ConsoleTitle}" Classes="caption consoleToggle" Classes.open="{Binding IsConsoleOpen}" VerticalAlignment="Center" />
          <Border CornerRadius="8" Padding="5,0" Background="{DynamicResource YaapicWarningBackgroundBrush}"
                  IsVisible="{Binding Console.WarnCount, Converter={x:Static p:ConsoleMap.IsPositive}}">
            <TextBlock Text="{Binding Console.WarnCount}" Classes="badge" Foreground="{DynamicResource YaapicWarningBrush}"
                       AutomationProperties.Name="{x:Static loc:Strings.StatusWarnings}" />
          </Border>
          <Border CornerRadius="8" Padding="5,0" Background="{DynamicResource YaapicDangerBackgroundBrush}"
                  IsVisible="{Binding Console.ErrorCount, Converter={x:Static p:ConsoleMap.IsPositive}}">
            <TextBlock Text="{Binding Console.ErrorCount}" Classes="badge" Foreground="{DynamicResource YaapicDangerBrush}"
                       AutomationProperties.Name="{x:Static loc:Strings.StatusErrors}" />
          </Border>
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</UserControl>
