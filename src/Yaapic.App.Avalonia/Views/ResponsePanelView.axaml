<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rsp="using:Yaapic.ViewModels.Responses"
             xmlns:d="using:Yaapic.Domain.Http"
             xmlns:p="using:Yaapic.App.Avalonia.Presentation"
             x:Class="Yaapic.App.Avalonia.Views.ResponsePanelView"
             x:DataType="rsp:ResponsePanelViewModel">
  <UserControl.Styles>
    <Style Selector="TabControl.panel > TabItem">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="TabControl.panel > TabItem:nth-child(1)">
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource YaapicSurfaceBaseBrush}">
    <Border Grid.Row="0" Classes="infobar warning" Margin="16,8,16,0"
            IsVisible="{Binding UnresolvedWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding UnresolvedWarning}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="1">
      <!-- Empty -->
      <Grid Background="{DynamicResource YaapicSurfaceSunkenBrush}"
            IsVisible="{Binding State, Converter={x:Static p:ResponseMap.IsEmpty}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <Path Width="64" Height="40" Stretch="None" HorizontalAlignment="Center" StrokeThickness="3"
                StrokeLineCap="Round" Stroke="{DynamicResource YaapicBorderOverlayBrush}"
                Data="M4 30h8M16 30h14M34 30h6M44 30h16M4 20h22M30 20h10M4 10h12" />
          <TextBlock Text="The response will appear here." HorizontalAlignment="Center"
                     Foreground="{DynamicResource YaapicTextSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Border Classes="keycap"><TextBlock Classes="codeSmall" Text="Ctrl" /></Border>
            <Border Classes="keycap"><TextBlock Classes="codeSmall" Text="Enter" /></Border>
            <TextBlock Text="to send" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource YaapicTextTertiaryBrush}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Sending -->
      <StackPanel VerticalAlignment="Top" IsVisible="{Binding State, Converter={x:Static p:ResponseMap.IsSending}}">
        <Border Height="36" Padding="16,0,12,0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
          <TextBlock Text="Sending" Classes="bodyStrong" VerticalAlignment="Center" />
        </Border>
        <ProgressBar IsIndeterminate="True" />
        <StackPanel Margin="16" Spacing="10">
          <Grid ColumnDefinitions="55*,45*"><Border Classes="skeleton" /></Grid>
          <Grid ColumnDefinitions="80*,20*"><Border Classes="skeleton" /></Grid>
          <Grid ColumnDefinitions="35*,65*"><Border Classes="skeleton" /></Grid>
        </StackPanel>
      </StackPanel>

      <!-- Failed -->
      <StackPanel Margin="16" Spacing="10" VerticalAlignment="Top"
                  IsVisible="{Binding State, Converter={x:Static p:ResponseMap.IsFailed}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource YaapicDangerBackgroundBrush}">
            <Viewbox Width="18" Height="18">
              <Path Width="24" Height="24" Stretch="None" Data="{StaticResource YaapicGlyphResponseFailed}"
                    StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="{DynamicResource YaapicDangerBrush}" />
            </Viewbox>
          </Border>
          <TextBlock Text="No response" Classes="subtitle" VerticalAlignment="Center" />
        </StackPanel>
        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="body"
                             Foreground="{DynamicResource YaapicTextSecondaryBrush}" />
      </StackPanel>

      <!-- Completed -->
      <Panel IsVisible="{Binding State, Converter={x:Static p:ResponseMap.IsCompleted}}">
        <TabControl Classes="panel" Padding="0">
          <TabItem>
            <TabItem.Header>
              <TextBlock Text="Body" />
            </TabItem.Header>
            <Grid RowDefinitions="40,*">
              <ListBox Classes="segmented" Margin="16,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       SelectedIndex="{Binding ViewMode, Converter={x:Static p:ResponseMap.ViewModeIndex}, Mode=OneWay}"
                       SelectionChanged="OnViewModeChanged">
                <ListBoxItem Content="Pretty" />
                <ListBoxItem Content="Raw" />
              </ListBox>
              <Panel Grid.Row="1" Background="{DynamicResource YaapicSurfaceSunkenBrush}">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}" />
                <TextBox IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" BorderThickness="0"
                         Background="Transparent" Padding="12,2" FontFamily="{DynamicResource YaapicMonoFont}"
                         FontSize="{DynamicResource YaapicFontSizeCode}" LineHeight="20"
                         IsVisible="{Binding !IsBinary}" Text="{Binding BodyText, Mode=OneWay}" />
                <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="12,2"
                         FontFamily="{DynamicResource YaapicMonoFont}"
                         FontSize="{DynamicResource YaapicFontSizeCode}" LineHeight="20"
                         IsVisible="{Binding IsBinary}" Text="{Binding BinaryText, Mode=OneWay}" />
              </Panel>
            </Grid>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Headers" />
                <TextBlock Classes="badge" Text="{Binding Headers.Count}"
                           IsVisible="{Binding Headers.Count, Converter={x:Static p:EditorMap.IsPositive}}" />
              </StackPanel>
            </TabItem.Header>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Headers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="d:KeyValueEntry">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
                      <Grid ColumnDefinitions="170,*" ColumnSpacing="16" Margin="14,0">
                        <SelectableTextBlock Grid.Column="0" Text="{Binding Key}" TextTrimming="CharacterEllipsis"
                                             Classes="codeSmall" LineHeight="24"
                                             Foreground="{DynamicResource YaapicSyntaxKeyBrush}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                             Classes="codeSmall" LineHeight="24"
                                             Foreground="{DynamicResource YaapicTextPrimaryBrush}"
                                             ToolTip.Tip="{Binding Value}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- Status block, in the header row at the right of the panel tabs. M2-24 adds copy and save after it. -->
        <StackPanel Orientation="Horizontal" Spacing="10" Height="36" Margin="0,0,12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
          <Border Classes="chip" VerticalAlignment="Center"
                  Background="{Binding StatusCategory, Converter={x:Static p:ResponseMap.StatusBackground}}"
                  AutomationProperties.Name="{Binding StatusText}" AutomationProperties.LiveSetting="Polite">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Viewbox Width="12" Height="12" IsVisible="{Binding StatusCategory, Converter={x:Static p:ResponseMap.IsSuccess}}">
                <Path Width="24" Height="24" Stretch="None" Data="{StaticResource YaapicGlyphStatusSuccess}"
                      StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding StatusCategory, Converter={x:Static p:ResponseMap.StatusForeground}}" />
              </Viewbox>
              <Viewbox Width="12" Height="12" IsVisible="{Binding StatusCategory, Converter={x:Static p:ResponseMap.IsClientError}}">
                <Path Width="24" Height="24" Stretch="None" Data="{StaticResource YaapicGlyphStatusClientError}"
                      StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding StatusCategory, Converter={x:Static p:ResponseMap.StatusForeground}}" />
              </Viewbox>
              <Viewbox Width="12" Height="12" IsVisible="{Binding StatusCategory, Converter={x:Static p:ResponseMap.IsServerError}}">
                <Path Width="24" Height="24" Stretch="None" Data="{StaticResource YaapicGlyphStatusServerError}"
                      StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding StatusCategory, Converter={x:Static p:ResponseMap.StatusForeground}}" />
              </Viewbox>
              <Viewbox Width="12" Height="12" IsVisible="{Binding StatusCategory, Converter={x:Static p:ResponseMap.IsInfo}}">
                <Path Width="24" Height="24" Stretch="None" Data="{StaticResource YaapicGlyphStatusInfo}"
                      StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding StatusCategory, Converter={x:Static p:ResponseMap.StatusForeground}}" />
              </Viewbox>
              <TextBlock Text="{Binding StatusText}"
                         Foreground="{Binding StatusCategory, Converter={x:Static p:ResponseMap.StatusForeground}}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding DurationText}" VerticalAlignment="Center" Classes="codeSmall"
                     Foreground="{DynamicResource YaapicTextSecondaryBrush}" />
          <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" Classes="codeSmall"
                     Foreground="{DynamicResource YaapicTextSecondaryBrush}" />
        </StackPanel>
      </Panel>
    </Grid>
  </Grid>
</UserControl>
