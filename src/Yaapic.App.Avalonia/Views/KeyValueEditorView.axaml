<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Yaapic.App.Avalonia.Controls"
             xmlns:ed="using:Yaapic.ViewModels.Editing"
             x:Name="Root"
             x:Class="Yaapic.App.Avalonia.Views.KeyValueEditorView"
             x:DataType="ed:KeyValueEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Border.row.placeholder">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.row.disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.row Button.remove">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.row:pointerover Button.remove">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.row Button.remove:focus">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.cellhost">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.cellhost:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource YaapicFocusRingBrush}" />
    </Style>
  </UserControl.Styles>
  <Border BorderThickness="1" BorderBrush="{DynamicResource YaapicBorderDefaultBrush}"
          CornerRadius="{DynamicResource YaapicRadiusMd}" ClipToBounds="True">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="28" ColumnDefinitions="36,*,2*,Auto,36"
            Background="{DynamicResource YaapicSurfaceSidebarBrush}">
        <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Margin="10,0"
                   Text="{Binding KeyHeader, ElementName=Root}" />
        <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource YaapicBorderDefaultBrush}">
          <TextBlock Classes="caption" VerticalAlignment="Center" Margin="10,0"
                     Text="{Binding ValueHeader, ElementName=Root}" />
        </Border>
        <Border Grid.Column="3" Width="36" IsVisible="{Binding AllowSecrets}" />
      </Grid>
      <!-- Locked vault: secret rows are unreadable until it is unlocked. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,4" IsVisible="{Binding ShowLockedCaption}">
        <TextBlock Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="Vault is locked. Unlock it to view or edit secret values." />
        <Button Grid.Column="1" Classes="subtle" Content="Unlock" MinHeight="24" Padding="8,0"
                AutomationProperties.Name="Unlock" Command="{Binding UnlockCommand}" />
      </Grid>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ed:KeyValueRowViewModel">
              <Border Classes="row" Classes.placeholder="{Binding IsEmpty}" Classes.disabled="{Binding !Enabled}"
                      BorderThickness="0,1,0,0" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
                <StackPanel>
                <Grid ColumnDefinitions="36,*,2*,Auto,36" Height="30">
                  <CheckBox Grid.Column="0" HorizontalAlignment="Center" MinWidth="0" Padding="0"
                            AutomationProperties.Name="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                  <Border Grid.Column="1" Classes="cellhost">
                    <c:VariableTextBox Watermark="Key" InputName="Key" FontSize="{DynamicResource YaapicFontSizeCode}"
                                       Context="{Binding #Root.VariableContext}" Text="{Binding Key, Mode=TwoWay}" />
                  </Border>
                  <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
                    <Border Classes="cellhost">
                      <Grid ColumnDefinitions="*,Auto">
                        <c:VariableTextBox Watermark="Value" InputName="Value" FontSize="{DynamicResource YaapicFontSizeCode}"
                                           IsEnabled="{Binding CanEditValue}" IsVisible="{Binding !IsMasked}"
                                           Context="{Binding #Root.VariableContext}" Text="{Binding Value, Mode=TwoWay}" />
                        <!-- A masked secret is shown, never edited: reveal it first. -->
                        <TextBox Classes="bare" IsReadOnly="True" AutomationProperties.Name="Value (secret)"
                                 FontFamily="{DynamicResource YaapicMonoFont}" FontSize="{DynamicResource YaapicFontSizeCode}"
                                 IsEnabled="{Binding CanEditValue}" IsVisible="{Binding IsMasked}" Text="{Binding DisplayValue, Mode=OneWay}" />
                        <Button Grid.Column="1" Classes="icon" Classes.on="{Binding IsRevealed}"
                                AutomationProperties.Name="Reveal" ToolTip.Tip="Show or hide the value"
                                IsEnabled="{Binding CanEditValue}" IsVisible="{Binding IsSecret}"
                                Command="{Binding ToggleRevealCommand}">
                          <PathIcon Data="{StaticResource YaapicGlyphEye}" />
                        </Button>
                      </Grid>
                    </Border>
                  </Border>
                  <Border Grid.Column="3" Width="36" IsVisible="{Binding $parent[UserControl].((ed:KeyValueEditorViewModel)DataContext).AllowSecrets}">
                    <Button Classes="icon" Classes.on="{Binding IsSecret}" HorizontalAlignment="Center"
                            AutomationProperties.Name="Secret" ToolTip.Tip="{Binding SecretToggleTooltip}"
                            IsEnabled="{Binding CanToggleSecret}" IsVisible="{Binding !IsEmpty}"
                            Command="{Binding ToggleSecretCommand}">
                      <PathIcon Data="{StaticResource YaapicGlyphLock}" />
                    </Button>
                  </Border>
                  <Button Grid.Column="4" Classes="icon remove" HorizontalAlignment="Center"
                          AutomationProperties.Name="Remove row" ToolTip.Tip="Remove row" IsVisible="{Binding !IsEmpty}"
                          Command="{Binding $parent[ItemsControl].((ed:KeyValueEditorViewModel)DataContext).RemoveRowCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource YaapicGlyphClose}" />
                  </Button>
                </Grid>
                <TextBlock Classes="caption" Margin="46,0,10,4" TextWrapping="Wrap" Text="{Binding Hint}"
                           IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="caption" Margin="46,0,10,4" TextWrapping="Wrap" Text="{Binding LastError}"
                           Foreground="{DynamicResource YaapicDangerBrush}"
                           IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
