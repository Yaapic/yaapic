<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="using:Yaapic.ViewModels.Editing"
             x:Class="Yaapic.App.Avalonia.Views.KeyValueEditorView"
             x:DataType="ed:KeyValueEditorViewModel">
  <ScrollViewer>
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="ed:KeyValueRowViewModel">
          <Grid ColumnDefinitions="Auto,*,*,Auto" Margin="0,0,0,4">
            <CheckBox Grid.Column="0" Margin="0,0,8,0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Margin="0,0,8,0" PlaceholderText="Key" Text="{Binding Key, Mode=TwoWay}" />
            <TextBox Grid.Column="2" Margin="0,0,8,0" PlaceholderText="Value" Text="{Binding Value, Mode=TwoWay}" />
            <Button Grid.Column="3" Content="✕" Background="Transparent" IsVisible="{Binding !IsEmpty}"
                    Command="{Binding $parent[ItemsControl].((ed:KeyValueEditorViewModel)DataContext).RemoveRowCommand}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
