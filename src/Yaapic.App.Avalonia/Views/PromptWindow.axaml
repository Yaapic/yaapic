<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaapic.App.Avalonia.Views.PromptWindow"
        Classes="dialog">
  <StackPanel>
    <StackPanel Margin="24,24,24,20" Spacing="8">
      <TextBlock x:Name="LabelText" Classes="title" TextWrapping="Wrap" />
      <TextBox x:Name="Input" />
    </StackPanel>
    <Border Classes="dialogCommands">
      <UniformGrid Rows="1">
        <Button x:Name="OkButton" Classes="accent" Content="OK" IsDefault="True" Click="OnOk" />
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      </UniformGrid>
    </Border>
  </StackPanel>
</Window>
