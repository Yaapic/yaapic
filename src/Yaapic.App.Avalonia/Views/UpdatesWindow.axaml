<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yaapic.ViewModels.Updates"
        x:Class="Yaapic.App.Avalonia.Views.UpdatesWindow"
        x:DataType="vm:UpdateViewModel"
        Title="Settings"
        Classes="dialog">
  <StackPanel>
    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,24,24,20" Spacing="16" Width="400">
        <StackPanel Spacing="2">
          <TextBlock Text="Yaapic" Classes="bodyStrong" />
          <TextBlock x:Name="VersionText" Classes="dialogBody" />
          <TextBlock x:Name="TaglineText" Classes="dialogBody" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="12">
          <TextBlock x:Name="AppearanceTitle" Classes="bodyStrong" />
          <TextBlock x:Name="LanguageLabel" />
          <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged" />
          <StackPanel x:Name="RestartPanel" Spacing="8" IsVisible="False">
            <TextBlock x:Name="RestartNote" Classes="dialogBody" TextWrapping="Wrap" />
            <Button x:Name="RestartButton" Click="OnRestartClick" HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock x:Name="AccentTitle" />
          <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="8" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="CustomBox" Width="200" MaxLength="7" TextChanged="OnCustomChanged" />
            <Button x:Name="ApplyButton" Click="OnApplyCustomClick" />
          </StackPanel>
          <TextBlock x:Name="CustomError" IsVisible="False" Classes="dialogBody" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="12">
          <TextBlock x:Name="UpdatesTitle" Classes="bodyStrong" />
          <TextBlock Text="Update channel" />
          <ComboBox x:Name="ChannelBox" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"
                    IsEnabled="{Binding IsSupported}" AutomationProperties.Name="Update channel" />
          <ToggleSwitch Content="Check for updates automatically" IsChecked="{Binding CheckAutomatically}"
                        AutomationProperties.Name="Check for updates automatically" />
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.Name="Update status" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check now" Command="{Binding CheckNowCommand}" />
            <Button Content="Download" Command="{Binding DownloadCommand}" IsVisible="{Binding ShowDownload}" />
            <Button Content="Restart to update" Classes="accent" Command="{Binding RestartAndApplyCommand}" IsVisible="{Binding ShowRestart}" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" IsVisible="{Binding IsDownloading}"
                       AutomationProperties.Name="Download progress" />
          <ScrollViewer MaxHeight="180" IsVisible="{Binding HasNotes}" AutomationProperties.Name="Release notes">
            <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" Classes="dialogBody" />
          </ScrollViewer>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Classes="dialogCommands">
      <Button Content="Close" Classes="accent" IsDefault="True" IsCancel="True" Click="OnClose" />
    </Border>
  </StackPanel>
</Window>
