<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loom="using:LoomEditor.Avalonia.Controls"
             x:Class="Yaapic.App.Avalonia.Views.CodeEditorView">
  <loom:LoomEditor x:Name="Editor" LineNumbersEnabled="True" FoldingEnabled="True" MinimapEnabled="False"
                   FontFamily="{DynamicResource YaapicMonoFont}" FontSize="{DynamicResource YaapicFontSizeCode}"
                   LineHeight="20" />
</UserControl>
