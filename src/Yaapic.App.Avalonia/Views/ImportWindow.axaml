<Window
    xmlns:loc="using:Yaapic.Localization" xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="using:Yaapic.ViewModels.Import"
    xmlns:p="using:Yaapic.App.Avalonia.Presentation"
    xmlns:v="using:Yaapic.App.Avalonia.Views"
    x:Class="Yaapic.App.Avalonia.Views.ImportWindow"
    x:DataType="i:ImportViewModel"
    x:CompileBindings="True"
    Title="{x:Static loc:Strings.ImportTitle}"
    Width="720" Height="560" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Classes="dialog">
  <Grid RowDefinitions="*,Auto">
    <Grid Margin="24,24,24,12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{x:Static loc:Strings.ImportChooseFile}" AutomationProperties.Name="{x:Static loc:Strings.ImportChooseFile}"
                Command="{Binding ChooseFileCommand}" />
        <Button Content="{x:Static loc:Strings.ImportChooseFolder}" AutomationProperties.Name="{x:Static loc:Strings.ImportChooseFolder}"
                Command="{Binding ChooseFolderCommand}" />
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource YaapicTextSecondaryBrush}"
                   Text="{Binding SourceName}" />
      </StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="72" Classes="code"
                 PlaceholderText="{x:Static loc:Strings.ImportPasteHint}" AutomationProperties.Name="{x:Static loc:Strings.ImportPasteHint}"
                 Text="{Binding PastedText, Mode=TwoWay}" />
        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{x:Static loc:Strings.ImportPreview}"
                AutomationProperties.Name="{x:Static loc:Strings.ImportPreview}" Command="{Binding PreviewPastedCommand}" />
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="260,*" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.ImportFormat}" />
          <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static loc:Strings.ImportFormat}"
                    ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="i:ImportFormatChoice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="{Binding DetectedFormat, Converter={x:Static p:TextMap.ImportDetected}}" />
      </Grid>
      <CheckBox Grid.Row="3" Content="{x:Static loc:Strings.ImportIncludeStatic}" AutomationProperties.Name="{x:Static loc:Strings.ImportIncludeStatic}"
                IsChecked="{Binding IncludeStaticResources, Mode=TwoWay}" IsVisible="{Binding ShowStaticResourcesOption}" />
      <TextBlock Grid.Row="4" TextWrapping="Wrap" Classes="bodyStrong" IsVisible="{Binding HasPreview}">
        <TextBlock.Text>
          <MultiBinding Converter="{x:Static p:TextMap.ImportCounts}">
            <Binding Path="Folders" />
            <Binding Path="Requests" />
            <Binding Path="Environments" />
            <Binding Path="GlobalVariables" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
      <v:ImportReportView Grid.Row="5" DataContext="{Binding Report}" />
      <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource YaapicDangerBrush}"
                   Text="{Binding Error}" IsVisible="{Binding HasError}" />
        <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Grid>
    <Border Grid.Row="1" Classes="dialogCommands">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Text="{Binding ResultSummary}" />
        <UniformGrid Grid.Column="1" Rows="1">
          <Button Classes="accent" Content="{x:Static loc:Strings.ImportTitle}" AutomationProperties.Name="{x:Static loc:Strings.ImportTitle}"
                  Command="{Binding ImportCommand}" />
          <Button IsCancel="True" Content="{x:Static loc:Strings.CommonClose}" AutomationProperties.Name="{x:Static loc:Strings.CommonClose}"
                  Click="OnClose" />
        </UniformGrid>
      </Grid>
    </Border>
  </Grid>
</Window>
