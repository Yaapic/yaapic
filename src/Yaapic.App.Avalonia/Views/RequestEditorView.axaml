<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:req="using:Yaapic.ViewModels.Requests"
             xmlns:p="using:Yaapic.App.Avalonia.Presentation"
             xmlns:v="using:Yaapic.App.Avalonia.Views"
             x:Class="Yaapic.App.Avalonia.Views.RequestEditorView"
             x:DataType="req:RequestEditorViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto,2*" Margin="16,8" RowSpacing="8">
    <TextBox Grid.Row="0" PlaceholderText="Untitled request" FontWeight="SemiBold"
             Text="{Binding Name, Mode=TwoWay}" />

    <Grid Grid.Row="1" ColumnDefinitions="100,*,Auto" ColumnSpacing="8">
      <ComboBox x:Name="MethodBox" Grid.Column="0" HorizontalAlignment="Stretch"
                SelectedIndex="{Binding Method, Converter={x:Static p:EditorMap.MethodIndex}, Mode=OneWay}"
                SelectionChanged="OnMethodChanged">
      </ComboBox>
      <TextBox Grid.Column="1" PlaceholderText="Enter URL or paste text"
               FontFamily="{DynamicResource YaapicMonoFont}" Text="{Binding Url, Mode=TwoWay}" />
      <Button Grid.Column="2" Content="Send" Classes="accent" Command="{Binding SendCommand}"
              IsVisible="{Binding !IsSending}" />
      <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}"
              IsVisible="{Binding IsSending}" />
    </Grid>

    <TabControl Grid.Row="2">
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="{Binding QueryParams.ActiveCount, StringFormat='Params ({0})'}" />
        </TabItem.Header>
        <v:KeyValueEditorView DataContext="{Binding QueryParams}" />
      </TabItem>
      <TabItem Header="Headers">
        <v:KeyValueEditorView DataContext="{Binding Headers}" />
      </TabItem>
      <TabItem Header="Body">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock Text="{Binding MethodText, StringFormat='{}{0} requests are sent without a body'}"
                     Foreground="{DynamicResource YaapicTextTertiaryBrush}" IsVisible="{Binding !AllowsBody}" />
          <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding AllowsBody}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <RadioButton GroupName="BodyKind" Content="none" Tag="0" Click="OnBodyKindClick"
                           IsChecked="{Binding BodyKind, Converter={x:Static p:EditorMap.IsNone}, Mode=OneWay}" />
              <RadioButton GroupName="BodyKind" Content="raw" Tag="1" Click="OnBodyKindClick"
                           IsChecked="{Binding BodyKind, Converter={x:Static p:EditorMap.IsRaw}, Mode=OneWay}" />
              <RadioButton GroupName="BodyKind" Content="x-www-form-urlencoded" Tag="2" Click="OnBodyKindClick"
                           IsChecked="{Binding BodyKind, Converter={x:Static p:EditorMap.IsUrlEncoded}, Mode=OneWay}" />
              <RadioButton GroupName="BodyKind" Content="form-data" Tag="3" Click="OnBodyKindClick"
                           IsChecked="{Binding BodyKind, Converter={x:Static p:EditorMap.IsFormData}, Mode=OneWay}" />
              <RadioButton GroupName="BodyKind" Content="binary" Tag="4" Click="OnBodyKindClick"
                           IsChecked="{Binding BodyKind, Converter={x:Static p:EditorMap.IsBinary}, Mode=OneWay}" />
              <ComboBox x:Name="ContentTypeBox" IsVisible="{Binding BodyKind, Converter={x:Static p:EditorMap.IsRaw}}"
                        SelectedIndex="{Binding BodyContentType, Converter={x:Static p:EditorMap.ContentTypeIndex}, Mode=OneWay}"
                        SelectionChanged="OnContentTypeChanged">
                <ComboBoxItem Content="JSON" />
                <ComboBoxItem Content="Text" />
                <ComboBoxItem Content="XML" />
                <ComboBoxItem Content="HTML" />
                <ComboBoxItem Content="JavaScript" />
              </ComboBox>
            </StackPanel>
            <TextBox Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="{DynamicResource YaapicMonoFont}" FontSize="{DynamicResource YaapicFontSizeCode}"
                     IsVisible="{Binding BodyKind, Converter={x:Static p:EditorMap.IsRaw}}"
                     Text="{Binding BodyText, Mode=TwoWay}" />
            <v:KeyValueEditorView Grid.Row="1" DataContext="{Binding UrlEncodedFields}"
                                  IsVisible="{Binding $parent[v:RequestEditorView].((req:RequestEditorViewModel)DataContext).BodyKind, Converter={x:Static p:EditorMap.IsUrlEncoded}}" />
            <v:FormDataEditorView Grid.Row="1" DataContext="{Binding FormData}"
                                  IsVisible="{Binding $parent[v:RequestEditorView].((req:RequestEditorViewModel)DataContext).BodyKind, Converter={x:Static p:EditorMap.IsFormData}}" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Top"
                  IsVisible="{Binding BodyKind, Converter={x:Static p:EditorMap.IsBinary}}">
              <TextBox IsReadOnly="True" PlaceholderText="No file selected" Text="{Binding BinaryFilePath, Mode=OneWay}" />
              <Button Grid.Column="1" Content="Select file" Command="{Binding PickBinaryFileCommand}" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>

    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" />
    <v:ResponsePanelView Grid.Row="4" DataContext="{Binding Response}" />
  </Grid>
</UserControl>
