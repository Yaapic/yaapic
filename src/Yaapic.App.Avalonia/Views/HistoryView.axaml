<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:Yaapic.ViewModels.History"
             xmlns:p="using:Yaapic.App.Avalonia.Presentation"
             x:Class="Yaapic.App.Avalonia.Views.HistoryView"
             x:DataType="h:HistoryViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="10,0,10,8">
      <TextBox Height="28" MinHeight="28" Padding="28,0,8,0" VerticalContentAlignment="Center"
               PlaceholderText="Filter history" AutomationProperties.Name="Filter history"
               Text="{Binding FilterText, Mode=TwoWay}" />
      <Viewbox Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
               IsHitTestVisible="False">
        <Canvas Width="24" Height="24">
          <Path Data="{StaticResource YiSearch}" Stroke="{DynamicResource YaapicTextTertiaryBrush}" StrokeThickness="2"
                StrokeLineCap="Round" StrokeJoin="Round" />
        </Canvas>
      </Viewbox>
      <Button Grid.Column="1" Content="Clear" Height="28" MinHeight="28" Padding="10,0"
              AutomationProperties.Name="Clear history" Command="{Binding ClearCommand}" />
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="h:HistoryGroup">
            <StackPanel>
              <TextBlock Text="{Binding Title}" Classes="caption" Margin="14,8,14,4"
                         Foreground="{DynamicResource YaapicTextSecondaryBrush}" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="h:HistoryItemViewModel">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,5"
                            CornerRadius="0" Background="Transparent" BorderThickness="0" Click="OnOpen"
                            AutomationProperties.Name="{Binding Url}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open" Click="OnOpen" />
                          <MenuItem Header="Delete" Click="OnDelete" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                          <TextBlock Width="44" Text="{Binding MethodText}" Classes="method" VerticalAlignment="Center"
                                     Foreground="{Binding Entry.Request.Method, Converter={x:Static p:BrushMap.MethodBrush}}" />
                          <TextBlock Grid.Column="1" Text="{Binding Url}" Classes="body" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="50,0,0,0">
                          <TextBlock Text="{Binding StatusText}" Classes="bodySmall" MaxWidth="150"
                                     TextTrimming="CharacterEllipsis">
                            <TextBlock.Foreground>
                              <MultiBinding Converter="{x:Static p:BrushMap.HistoryStatus}">
                                <Binding Path="StatusCategory" />
                                <Binding Path="IsFailed" />
                              </MultiBinding>
                            </TextBlock.Foreground>
                          </TextBlock>
                          <TextBlock Text="{Binding TimeText}" Classes="bodySmall"
                                     Foreground="{DynamicResource YaapicTextTertiaryBrush}" />
                          <TextBlock Text="{Binding DurationText}" Classes="bodySmall"
                                     Foreground="{DynamicResource YaapicTextTertiaryBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="1" Text="No requests sent yet" Classes="bodySmall" HorizontalAlignment="Center"
               VerticalAlignment="Top" Margin="16,24,16,0" Foreground="{DynamicResource YaapicTextSecondaryBrush}"
               IsVisible="{Binding IsEmpty}" />
  </Grid>
</UserControl>
