<UserControl
    xmlns:loc="using:Yaapic.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="using:Yaapic.ViewModels.Editing"
             xmlns:p="using:Yaapic.App.Avalonia.Presentation"
             x:Class="Yaapic.App.Avalonia.Views.FormDataEditorView"
             x:DataType="ed:FormDataEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Border.row.placeholder">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.row.disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.row Button.remove">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.row:pointerover Button.remove">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.row Button.remove:focus">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <Border BorderThickness="1" BorderBrush="{DynamicResource YaapicBorderDefaultBrush}"
          CornerRadius="{DynamicResource YaapicRadiusMd}" ClipToBounds="True">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="28" ColumnDefinitions="36,*,72,2*,36"
            Background="{DynamicResource YaapicSurfaceSidebarBrush}">
        <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Margin="10,0" Text="{x:Static loc:Strings.EditorKeyUpper}" />
        <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Margin="10,0,0,0" Text="{x:Static loc:Strings.EditorTypeUpper}" />
        <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource YaapicBorderDefaultBrush}">
          <TextBlock Classes="caption" VerticalAlignment="Center" Margin="10,0" Text="{x:Static loc:Strings.EditorValueUpper}" />
        </Border>
      </Grid>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ed:FormDataRowViewModel">
              <Border Classes="row" Classes.placeholder="{Binding IsEmpty}" Classes.disabled="{Binding !Enabled}"
                      Height="30" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
                <Grid ColumnDefinitions="36,*,72,2*,36">
                  <CheckBox Grid.Column="0" HorizontalAlignment="Center" MinWidth="0" Padding="0"
                            AutomationProperties.Name="{x:Static loc:Strings.CommonEnabled}" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                  <TextBox Grid.Column="1" Classes="cell" PlaceholderText="{x:Static loc:Strings.EditorKey}" Text="{Binding Key, Mode=TwoWay}" />
                  <ComboBox Grid.Column="2" Classes="cell" Tag="{Binding}" AutomationProperties.Name="{x:Static loc:Strings.FormdataKind}"
                            SelectedIndex="{Binding Kind, Converter={x:Static p:EditorMap.FieldKindIndex}, Mode=OneWay}"
                            SelectionChanged="OnKindChanged">
                    <ComboBoxItem Content="{x:Static loc:Strings.CommonText}" />
                    <ComboBoxItem Content="{x:Static loc:Strings.CommonFile}" />
                  </ComboBox>
                  <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Classes="cell" PlaceholderText="{x:Static loc:Strings.EditorValue}" IsReadOnly="{Binding IsFile}"
                               Text="{Binding Value, Mode=TwoWay}" />
                      <Button Grid.Column="1" Classes="subtle" Content="{x:Static loc:Strings.CommonBrowse}" Margin="0,0,4,0" VerticalAlignment="Center"
                              IsVisible="{Binding IsFile}" Command="{Binding PickFileCommand}" />
                    </Grid>
                  </Border>
                  <Button Grid.Column="4" Classes="icon remove" HorizontalAlignment="Center"
                          AutomationProperties.Name="{x:Static loc:Strings.EditorRemoveRow}" ToolTip.Tip="{x:Static loc:Strings.EditorRemoveRow}" IsVisible="{Binding !IsEmpty}"
                          Command="{Binding $parent[ItemsControl].((ed:FormDataEditorViewModel)DataContext).RemoveRowCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource YaapicGlyphClose}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
