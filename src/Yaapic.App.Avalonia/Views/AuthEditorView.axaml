<UserControl
    xmlns:loc="using:Yaapic.Localization" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:req="using:Yaapic.ViewModels.Requests"
             xmlns:p="using:Yaapic.App.Avalonia.Presentation"
             x:Class="Yaapic.App.Avalonia.Views.AuthEditorView"
             x:DataType="req:AuthEditorViewModel">
  <StackPanel Margin="16,12" Spacing="12" MaxWidth="480" HorizontalAlignment="Left">
    <StackPanel Spacing="6">
      <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.CommonType}" />
      <ComboBox x:Name="KindBox" MinWidth="200" AutomationProperties.Name="{x:Static loc:Strings.AuthType}"
                SelectedIndex="{Binding Kind, Converter={x:Static p:EditorMap.AuthKindIndex}, Mode=OneWay}"
                SelectionChanged="OnKindChanged">
        <ComboBoxItem Content="{x:Static loc:Strings.BodyNone}" />
        <ComboBoxItem Content="Basic Auth" />
        <ComboBoxItem Content="Bearer Token" />
        <ComboBoxItem Content="API Key" />
      </ComboBox>
    </StackPanel>

    <TextBlock Classes="bodySmall" Text="{x:Static loc:Strings.AuthNone}"
               Foreground="{DynamicResource YaapicTextTertiaryBrush}"
               IsVisible="{Binding Kind, Converter={x:Static p:EditorMap.IsNoAuth}}" />

    <StackPanel Spacing="12" IsVisible="{Binding Kind, Converter={x:Static p:EditorMap.IsBasicAuth}}">
      <StackPanel Spacing="6">
        <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.AuthUsername}" />
        <TextBox PlaceholderText="{x:Static loc:Strings.EditingVariableHint}" Text="{Binding Username, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.AuthPassword}" />
        <TextBox PlaceholderText="{x:Static loc:Strings.EditingVariableHint}" PasswordChar="●"
                 Text="{Binding Password, Mode=TwoWay}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="6" IsVisible="{Binding Kind, Converter={x:Static p:EditorMap.IsBearerAuth}}">
      <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.AuthToken}" />
      <TextBox PlaceholderText="{x:Static loc:Strings.EditingVariableHint}" PasswordChar="●"
               Text="{Binding Token, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel Spacing="12" IsVisible="{Binding Kind, Converter={x:Static p:EditorMap.IsApiKeyAuth}}">
      <StackPanel Spacing="6">
        <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.EditorKey}" />
        <TextBox PlaceholderText="{x:Static loc:Strings.EditingVariableHint}" Text="{Binding Key, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.EditorValue}" />
        <TextBox PlaceholderText="{x:Static loc:Strings.EditingVariableHint}" Text="{Binding Value, Mode=TwoWay}" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="bodyStrong" Text="{x:Static loc:Strings.AuthAddTo}" />
        <ComboBox x:Name="LocationBox" MinWidth="200" AutomationProperties.Name="{x:Static loc:Strings.AuthApiKeyLocation}"
                  SelectedIndex="{Binding Location, Converter={x:Static p:EditorMap.LocationIndex}, Mode=OneWay}"
                  SelectionChanged="OnLocationChanged">
          <ComboBoxItem Content="{x:Static loc:Strings.AuthLocationHeader}" />
          <ComboBoxItem Content="{x:Static loc:Strings.AuthLocationQuery}" />
        </ComboBox>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
