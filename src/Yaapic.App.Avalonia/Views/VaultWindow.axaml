<Window
    xmlns:loc="using:Yaapic.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yaapic.App.Avalonia.Views.VaultWindow"
        Classes="dialog">
  <StackPanel>
    <StackPanel Margin="24,24,24,20" Spacing="12" Width="400">
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource YaapicDangerBrush}" TextWrapping="Wrap" IsVisible="False"
                 AutomationProperties.Name="{x:Static loc:Strings.CommonError}" />
      <StackPanel x:Name="SetupPanel" Spacing="12">
        <TextBlock Classes="dialogBody"
                   Text="{x:Static loc:Strings.VaultSetupHint}" />
        <TextBlock Text="{x:Static loc:Strings.VaultProtectWith}" />
        <StackPanel x:Name="Protectors" Spacing="6" AutomationProperties.Name="{x:Static loc:Strings.VaultProtector}" />
        <StackPanel x:Name="PassphrasePanel" Spacing="8">
          <TextBox x:Name="Passphrase" PasswordChar="●" PlaceholderText="{x:Static loc:Strings.VaultProtectorPassphrase}" AutomationProperties.Name="{x:Static loc:Strings.VaultProtectorPassphrase}" />
          <TextBox x:Name="Confirm" PasswordChar="●" PlaceholderText="{x:Static loc:Strings.VaultConfirmPassphrase}" AutomationProperties.Name="{x:Static loc:Strings.VaultConfirmPassphrase}" />
          <TextBlock x:Name="HintText" Classes="caption" Foreground="{DynamicResource YaapicDangerBrush}" IsVisible="False" />
        </StackPanel>
      </StackPanel>
      <TextBox x:Name="Unlock" PasswordChar="●" PlaceholderText="{x:Static loc:Strings.VaultProtectorPassphrase}" AutomationProperties.Name="{x:Static loc:Strings.VaultProtectorPassphrase}" />
    </StackPanel>
    <Border Classes="dialogCommands">
      <UniformGrid Rows="1">
        <Button x:Name="SubmitButton" Classes="accent" IsDefault="True" Click="OnSubmit" />
        <Button Content="{x:Static loc:Strings.CommonCancel}" IsCancel="True" Click="OnCancel" />
      </UniformGrid>
    </Border>
  </StackPanel>
</Window>
