<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:env="using:Yaapic.ViewModels.Environments"
        xmlns:shell="using:Yaapic.ViewModels.Shell"
        xmlns:views="using:Yaapic.App.Avalonia.Views"
        xmlns:pres="using:Yaapic.App.Avalonia.Presentation"
        x:Class="Yaapic.App.Avalonia.Views.EnvironmentsWindow"
        x:DataType="shell:ShellViewModel"
        Title="Environments"
        Width="960" Height="560" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource YaapicSurfaceBaseBrush}">
  <Grid ColumnDefinitions="240,Auto,*">
    <Grid Grid.Column="0" RowDefinitions="40,Auto,*" Background="{DynamicResource YaapicSurfaceSidebarBrush}">
      <Grid Margin="14,0,8,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Environments" Classes="bodyStrong" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon" Command="{Binding Environments.AddCommand}"
                ToolTip.Tip="New environment" AutomationProperties.Name="New environment">
          <PathIcon Data="{StaticResource YaapicGlyphAdd}" />
        </Button>
      </Grid>
      <Border Grid.Row="1" Background="{Binding Environments.IsEditingGlobals, Converter={x:Static pres:EnvironmentMap.RowBackground}}">
        <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="32" Padding="14,0"
                CornerRadius="0" Click="OnSelectGlobals" AutomationProperties.Name="Globals">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="Globals" VerticalAlignment="Center"
                       FontWeight="{Binding Environments.IsEditingGlobals, Converter={x:Static pres:EnvironmentMap.Weight}}" />
            <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource YaapicAccentFillBrush}"
                     IsVisible="{Binding Globals.IsDirty}" ToolTip.Tip="Unsaved changes" />
          </Grid>
        </Button>
      </Border>
      <ListBox Grid.Row="2" Background="Transparent" ItemsSource="{Binding Environments.Environments}"
               SelectedItem="{Binding Environments.EditedEnvironment, Mode=TwoWay}">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="32" />
          </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="env:EnvironmentItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <Ellipse Width="8" Height="8" Fill="{Binding IsActive, Converter={x:Static pres:EnvironmentMap.Dot}}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         FontWeight="{Binding IsEdited, Converter={x:Static pres:EnvironmentMap.Weight}}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource YaapicAccentFillBrush}"
                         IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved changes" />
                <TextBlock Text="active" Classes="caption" IsVisible="{Binding IsActive}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Column="1" Width="1" Background="{DynamicResource YaapicBorderSubtleBrush}" />

    <Grid Grid.Column="2" Background="{DynamicResource YaapicSurfaceBaseBrush}">
      <Grid RowDefinitions="56,*" IsVisible="{Binding Environments.EditedEnvironment, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
          <Grid Margin="20,0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"
                DataContext="{Binding Environments.EditedEnvironment}" x:DataType="env:EnvironmentItemViewModel">
            <Ellipse Width="10" Height="10" Fill="{Binding IsActive, Converter={x:Static pres:EnvironmentMap.Dot}}" />
            <TextBox Grid.Column="1" VerticalAlignment="Center" PlaceholderText="Environment name"
                     BorderThickness="0" Background="Transparent" Padding="0"
                     FontSize="{DynamicResource YaapicFontSizeTitle}" FontWeight="SemiBold"
                     Text="{Binding Name, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Classes="bodySmall" Foreground="{DynamicResource YaapicTextTertiaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       Text="{Binding Variables.ActiveCount, Converter={x:Static pres:EnvironmentMap.VariableCount}}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="Duplicate" Classes="subtle" Click="OnDuplicate" />
              <Button x:Name="DeleteButton" Content="Delete" Classes="danger">
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Spacing="8">
                      <TextBlock x:Name="DeletePrompt" />
                      <Button Content="Delete" Classes="danger" Click="OnConfirmDelete" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Content="Save" Classes="accent" Click="OnSave" />
            </StackPanel>
          </Grid>
        </Border>
        <views:KeyValueEditorView Grid.Row="1" Margin="20,12,20,16" KeyHeader="VARIABLE"
                                  DataContext="{Binding Environments.EditedEnvironment.Variables}" />
      </Grid>
      <Grid RowDefinitions="56,Auto,*" IsVisible="{Binding Environments.IsEditingGlobals}">
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
          <Grid Margin="20,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Globals" VerticalAlignment="Center" FontSize="{DynamicResource YaapicFontSizeTitle}" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Save" Classes="accent" VerticalAlignment="Center" Command="{Binding Globals.SaveCommand}" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="20,12,20,0" Spacing="8">
          <TextBlock Classes="bodySmall" Foreground="{DynamicResource YaapicTextSecondaryBrush}" TextWrapping="Wrap"
                     Text="Available in every request; the active environment and the collection override them." />
          <Border Classes="infobar danger" IsVisible="{Binding Globals.LastError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Globals.LastError}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
        <views:KeyValueEditorView Grid.Row="2" Margin="20,12,20,16" KeyHeader="VARIABLE" DataContext="{Binding Globals.Variables}" />
      </Grid>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select an environment, or add one."
                 Foreground="{DynamicResource YaapicTextSecondaryBrush}"
                 >
        <TextBlock.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!Environments.IsEditingGlobals" />
            <Binding Path="Environments.EditedEnvironment" Converter="{x:Static ObjectConverters.IsNull}" />
          </MultiBinding>
        </TextBlock.IsVisible>
      </TextBlock>
    </Grid>
  </Grid>
</Window>
