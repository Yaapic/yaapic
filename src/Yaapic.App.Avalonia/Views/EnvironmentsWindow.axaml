<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:env="using:Yaapic.ViewModels.Environments"
        xmlns:views="using:Yaapic.App.Avalonia.Views"
        x:Class="Yaapic.App.Avalonia.Views.EnvironmentsWindow"
        x:DataType="env:EnvironmentsViewModel"
        Title="Environments"
        Width="960" Height="560" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource YaapicSurfaceBaseBrush}">
  <Grid ColumnDefinitions="240,*">
    <Border Grid.Column="0" Background="{DynamicResource YaapicSurfaceSidebarBrush}"
            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource YaapicBorderSubtleBrush}">
      <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Text="Environments" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Add" Command="{Binding AddCommand}" />
        </Grid>
        <ListBox Grid.Row="1" Background="Transparent" ItemsSource="{Binding Environments}"
                 SelectedItem="{Binding EditedEnvironment, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="env:EnvironmentItemViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource YaapicAccentFillBrush}"
                           IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved changes" />
                  <TextBlock Text="active" FontSize="12" Foreground="{DynamicResource YaapicTextTertiaryBrush}"
                             IsVisible="{Binding IsActive}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid RowDefinitions="56,*" IsVisible="{Binding EditedEnvironment, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid Margin="20,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12"
              DataContext="{Binding EditedEnvironment}" x:DataType="env:EnvironmentItemViewModel">
          <TextBox Grid.Column="0" VerticalAlignment="Center" PlaceholderText="Environment name"
                   Text="{Binding Name, Mode=TwoWay}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center"
                     Foreground="{DynamicResource YaapicTextTertiaryBrush}"
                     Text="{Binding Variables.ActiveCount, StringFormat='{}{0} enabled'}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="DeleteButton" Content="Delete" Foreground="{DynamicResource YaapicDangerBrush}">
              <Button.Flyout>
                <Flyout>
                  <StackPanel Spacing="8">
                    <TextBlock x:Name="DeletePrompt" />
                    <Button Content="Delete" Foreground="{DynamicResource YaapicDangerBrush}" Click="OnConfirmDelete" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Content="Save" Classes="accent" Click="OnSave" />
          </StackPanel>
        </Grid>
        <views:KeyValueEditorView Grid.Row="1" Margin="20,12,20,16"
                                  DataContext="{Binding EditedEnvironment.Variables}" />
      </Grid>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select an environment, or add one."
                 Foreground="{DynamicResource YaapicTextSecondaryBrush}"
                 IsVisible="{Binding EditedEnvironment, Converter={x:Static ObjectConverters.IsNull}}" />
    </Grid>
  </Grid>
</Window>
