  <!-- Contraste élevé : ThemeVariant personnalisée « HighContrast » déclarée dans App.axaml -->
  <CornerRadius x:Key="YaapicRadiusControl">6</CornerRadius>
  <CornerRadius x:Key="YaapicRadiusOverlay">8</CornerRadius>
  <x:Double x:Key="YaapicControlHeight">32</x:Double>
  <x:Double x:Key="YaapicRowHeight">28</x:Double>
  <FontFamily x:Key="YaapicMonoFont">avares://Yaapic/Assets/Fonts#JetBrains Mono</FontFamily>
  <BoxShadows x:Key="YaapicElevation2">0 8 16 0 #5C000000</BoxShadows>
  <BoxShadows x:Key="YaapicElevation3">0 24 48 0 #80000000</BoxShadows>
</ResourceDictionary>
